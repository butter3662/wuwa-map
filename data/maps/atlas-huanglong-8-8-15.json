s/layers/8/-1_58/{x}_{y}.webp","tileSize":768,"columns":30,"rows":31,"availableTiles":["5,-17","5,-18"],"ext":["5,-17","5,-18"]}}],"descs":[{"p":"","o":"靠近标点后开始挑战","l":"zh-CN"},{"p":"","o":"两个一起与残星会交战","l":"zh-CN"},{"p":"","o":"亭子里","l":"zh-CN"},{"k":"3마리가 함께"},{"p":"","o":"沿断开的道路巡逻","l":"zh-CN"},{"p":"","o":"三只一起在道路中间","l":"zh-CN"},{"p":"","o":"两个一起和两个狮子镇守潮汐之遗","l":"zh-CN"},{"p":"","o":"沿道路来回巡逻","l":"zh-CN"},{"p":"","o":"虽然有点看不清，但是这里有4块玟华璧","l":"zh-CN"},{"p":"","o":"悬空，采集即可","l":"zh-CN"},{"k":"바로 채집 가능"},{"k":"공중에 떠 있음, 바로 채집 가능"},{"p":"","o":"需完成任务再演战影后可解锁","l":"zh-CN"},{"p":"","o":"和狮子头交互","l":"zh-CN"},{"k":"끊임없이 확장되는 구정 속에는 수많은 뒤틀린 마음으로 이루어진 거대한 몸체가 갇혀 있다.\n그들의 진정한 목소리에 귀 기울여, 옛 영혼들을 해방으로 인도하자"},{"p":"56층","o":"需完成危行任务·雾锁机伶后进入该区域进行挑战","l":"zh-CN"},{"p":"","o":"任务宝箱，任务地点在第二张图红框位置，靠近之后会有任务指引，宝箱左边的就是任务NPC。","l":"zh-CN"},{"p":"","o":"不需要清怪，直接拿就可以。","l":"zh-CN"},{"k":"적을 처치해야 한다."},{"p":"","o":"这是一个挑战宝箱，挑战地点在第二、三张图，靠近会有紫色任务指引。","l":"zh-CN"},{"p":"","o":"直接拿就行，不需要清怪。","l":"zh-CN"},{"p":"56층","o":"这个宝箱需要把雾隐阁全部支线任务搞定，然后中间位置采会开启向下的电梯，之后跟着任务一直走，走到第二张图秧秧的位置，暂时别跟着任务跑，朝前方一直走。","l":"zh-CN"},{"p":"56층","o":"这个宝箱需要把雾隐阁全部支线任务搞定，然后中间位置采会开启向下的电梯，之后跟着任务一直走，走到第二张图电梯这个位置，先去到最下面，走下去就行，有一个基准宝箱。。","l":"zh-CN"},{"p":"57층","o":"雾隐阁系列任务得最后，在中央区域会开放两个电梯，也就是第三张图的位置，下电梯，之后就会来到第二张图的位置，进入那个水帘洞；进到这里之后，会看到一个任务指引，需要点灯，之后这个基准宝箱就出现了。","l":"zh-CN"},{"p":"","o":"挑战宝箱","l":"zh-CN"},{"p":"","o":"走格子小游戏。","l":"zh-CN"},{"p":"56층","o":"这个宝箱需要把雾隐阁全部支线任务搞定，然后中间位置采会开启向下的电梯，之后跟着任务一直走，走到千小妹这里，在千小妹这张图的右上角那个板子上，有个精密宝箱，帮助机器人过来，自动获取。。","l":"zh-CN"},{"p":"","o":"标点位置建筑的最高房顶。","l":"zh-CN"},{"p":"","o":"瀑布柱子的最高处。","l":"zh-CN"},{"p":"58층","o":"先接取雾隐阁的任务，然后从第二张图红框位置的雾隐阁入口进入，顺着任务指引走，开了第一个门就能看到。","l":"zh-CN"},{"p":"56층","o":"这个宝箱需要把雾隐阁全部支线任务搞定，然后中间位置采会开启向下的电梯，出了电梯右拐，开一下扫描。","l":"zh-CN"},{"p":"56층","o":"这个宝箱需要把雾隐阁全部支线任务搞定，然后中间位置采会开启向下的电梯，之后跟着任务一直走，走到第二张图秧秧的位置，暂时别跟着任务跑，朝秧秧左上交心月狐的位置走，开扫描。","l":"zh-CN"},{"p":"56층","o":"这个宝箱需要把雾隐阁全部支线任务搞定，然后中间位置采会开启向下的电梯，之后跟着任务一直走，走到第二张图秧秧的位置，暂时别跟着任务跑，朝秧秧面前最远方的亭子，一直走。","l":"zh-CN"},{"p":"57층","o":"雾隐阁系列任务得最后，在中央区域会开放两个电梯，也就是第三张图的位置，下电梯，之后就会来到第二张图的位置，进入那个水帘洞，然后开扫描。","l":"zh-CN"},{"p":"57층","o":"雾隐阁系列任务得最后，在中央区域会开放两个电梯，也就是第三张图的位置，下电梯，之后就会来到第二张图的位置，进入那个引歧帘，然后开扫描。","l":"zh-CN"},{"p":"","o":"咎锁遗患挑战宝箱，需要打红名怪。","l":"zh-CN"},{"p":"","o":"红名怪挑战宝箱。","l":"zh-CN"},{"p":"","o":"旁白：“千咲！你到底干了什么！没有主C我等如何抗争湮灭红名怪！”千咲淡淡一笑，语气平淡但充满狂傲：“简单，我当主C不就好了。”说罢，她气息终于不再掩饰，显露而出。六命修为！","l":"zh-CN"},{"p":"56층","o":"先做完“雾锁机伶”，然后再来一遍这里，就能刷新怪物。","l":"zh-CN"}],"markers":[["1524182456214077440",0,4604.7,10167.9,"0",0],["1526653263574056960",1,4108.3,10558.6,"0",-1],["1526653263683108864",1,4109.3,10558.6,"0",-1],["1526653263792160768",1,4108.3,10559.5,"0",-1],["1526672509293150208",1,4108.3,10560.5,"0",-1],["1526672509398007808",1,4109.3,10562.3,"0",-1],["1526672509502865408",1,4108.3,10562.3,"0",-1],["1526734007960326144",1,4069.5,10481.8,"0",-1],["1526734008128098304",1,4068.6,10480.9,"0",-1],["1526734008295870464",1,4068.6,10480.5,"0",-1],["1526736157814407168",1,4092.1,10500.8,"0",-1],["1526736157915070464",1,4093.0,10501.7,"0",-1],["1526736158015733760",1,4093.0,10502.2,"0",-1],["1526736158112202752",1,4092.1,10502.6,"0",-1],["1526736965553471488",1,4090.3,10487.3,"0",-1],["1526736965654134784",1,4090.3,10487.7,"0",-1],["1527367970366799872",1,4290.0,10784.5,"0",-1],["1527368068680634368",1,4277.3,10792.7,"0",-1],["1527368312001249280",1,4270.1,10766.5,"0",-1],["1527368761147641856",1,4280.0,10753.8,"0",-1],["1527368761323802624",1,4280.9,10754.7,"0",-1],["1527368761499963392",1,4283.6,10755.6,"0",-1],["1527469953866121216",1,4535.7,10746.6,"0",-1],["1527469953975173120",1,4537.5,10746.6,"0",-1],["1527469954080030720",1,4538.4,10746.6,"0",-1],["1527470773705101312",1,4564.6,10752.9,"0",-1],["1527470773872873472",1,4565.5,10752.9,"0",-1],["1527470774036451328",1,4565.5,10753.8,"0",-1],["1527471217223389184",1,4561.9,10752,"0",-1],["1527471217386967040",1,4561.9,10752.5,"0",-1],["1527471894901280768",1,4561.0,10748.4,"0",-1],["1527471895077441536",1,4560.1,10748.4,"0",-1],["15274732685658521