"g":"exploration","c":"#f8c963","i":"tiles/icons/35bb0bb1bbd2f285b3bf.webp"}],"def":["qzx_02","qzx_03","qzx_01","qzx_04"],"layers":[{"id":"-1/23","n":"명상소","gid":"23","gn":"명상소","t":{"src":"tiles/layers/8/-1_23/{x}_{y}.webp","tileSize":768,"columns":30,"rows":31,"availableTiles":["26,-2"],"ext":["26,-2"]}},{"id":"-1/24","n":"울림 동굴","gid":"24","gn":"울림 동굴","t":{"src":"tiles/layers/8/-1_24/{x}_{y}.webp","tileSize":768,"columns":30,"rows":31,"availableTiles":["26,-2","27,-2"],"ext":["26,-2","27,-2"]}},{"id":"-1/25","n":"붉은 숲 바위굴","gid":"25","gn":"붉은 숲 바위굴","t":{"src":"tiles/layers/8/-1_25/{x}_{y}.webp","tileSize":768,"columns":30,"rows":31,"availableTiles":["26,-1","27,-1"],"ext":["26,-1","27,-1"]}},{"id":"-1/27","n":"침식 땅굴","gid":"27","gn":"침식 땅굴","t":{"src":"tiles/layers/8/-1_27/{x}_{y}.webp","tileSize":768,"columns":30,"rows":31,"availableTiles":["26,-1"],"ext":["26,-1"]}}],"descs":[{"p":"","o":"击败红名怪后可解锁潮汐之遗金（特别提醒：标点位置不在地面上，位于半空中的平台上哦）","l":"zh-CN"},{"k":"해당 적은 용융 피해 저항이 증가한다.\n상귀스 사냥 평원에 서식하는 보기 드문 거대 잔상. 용암을 내뿜고 온몸은 비늘로 뒤덮여 있으며, 그의 우뚝 솟은 뿔은 패권자로서의 상징이다.\n밀려온 「흑조(黑潮)」와 함께 나타난 코로사우루스는 일곱 언덕의 검투사를 향해 포효하며, 마치 영광의 사냥이 시작됐다는 것을 알리는 듯하다"},{"p":"24층","o":"该标点位于地下区域且需先完成以呼嚎致意任务才可进入（当然你可以试试走另外一边进）\n栖息于桑古伊斯狩原的罕见巨型残象，喷吐炙岩，身覆鳞甲，其峥嵘的角冠，是身为霸主的象征。\n与上涨的「黑潮」一同现身的蚀脊龙，以嘶吼向七丘的角斗士们宣告：荣耀的行猎已然开始","l":"zh-CN"},{"k":"해당 적은 용융 피해 저항이 증가한다.\n상귀스 사냥 평원에 서식하는 보기 드문 거대 잔상. 용암을 내뿜고 온몸은 비늘로 뒤덮여 있으며, 그의 우뚝 솟은 뿔은 패권자로서의 상징이다.\n밀려온 「흑조(黑潮)」와 함께 나타난 코로사우루스는 일곱 언덕의 검투사를 향해 포효하며, 마치 영광의 사냥이 시작됐다는 것을 알리는 듯하다"},{"k":"해당 적은 용융 피해 저항이 증가한다.\n상귀스 사냥 평원에 서식하는 보기 드문 거대 잔상. 용암을 내뿜고 온몸은 비늘로 뒤덮여 있으며, 그의 우뚝 솟은 뿔은 패권자로서의 상징이다.\n밀려온 「흑조(黑潮)」와 함께 나타난 코로사우루스는 일곱 언덕의 검투사를 향해 포효하며, 마치 영광의 사냥이 시작됐다는 것을 알리는 듯하다"},{"p":"27층","o":"该标点位于地下区域，请注意——栖息于桑古伊斯狩原的罕见巨型残象，喷吐炙岩，身覆鳞甲，其峥嵘的角冠，是身为霸主的象征。与上涨的「黑潮」一同现身的蚀脊龙，以嘶吼向七丘的角斗士们宣告：荣耀的行猎已然开始","l":"zh-CN"},{"k":"해당 적은 용융 피해 저항이 증가한다.\n상귀스 사냥 평원에 서식하는 보기 드문 거대 잔상. 용암을 내뿜고 온몸은 비늘로 뒤덮여 있으며, 그의 우뚝 솟은 뿔은 패권자로서의 상징이다.\n밀려온 「흑조(黑潮)」와 함께 나타난 코로사우루스는 일곱 언덕의 검투사를 향해 포효하며, 마치 영광의 사냥이 시작됐다는 것을 알리는 듯하다"},{"k":"「명식 · 레비아탄」이 리나시타 사람들의 기억과 감정, 그리고 염원을 하나로 융합해 만들어낸 이 나라는 모든 생각을 흡수하고, 모든 집착을 씻어낸다. 흠결 없는 순결한 천국이 혼란스러운 마음의 틈 사이에 높이 떠 있으며, 죽은 자들의 순례는 여전히 계속되고 있다. 그들은 밤낮없이 한마음으로 찬송을 부르며, 오직 그분의 은혜와 구원을 간절히 바라고 있다"},{"p":"","o":"位于半空中，在石柱的后面。可传送到图2的信标后走到悬崖边，跳下悬崖后往右飞一段就能看见","l":"zh-CN"},{"p":"","o":"位于巨大石像的头顶。传送到附近的信标后直接往上飞即可看到","l":"zh-CN"},{"p":"","o":"传送到附近中枢信标，回头直接用钩索获取","l":"zh-CN"},{"p":"","o":"位于半空，旗帜的上方。使用翱翔飞上去即可获得","l":"zh-CN"},{"p":"","o":"位于山体顶端，飞过来即可获取","l":"zh-CN"},{"p":"","o":"位于建筑废墟中，靠近用钩索即可获取","l":"zh-CN"},{"p":"","o":"位于半空，飞过去即可获取","l":"zh-CN"},{"p":"","o":"位于山体夹缝之间","l":"zh-CN"},{"p":"","o":"位于石柱顶部","l":"zh-CN"},{"p":"","o":"位于山体顶端","l":"zh-CN"},{"p":"","o":"位于瀑布中，靠近使用钩索即可获取","l":"zh-CN"},{"p":"","o":"位于半空，如果从附近信标过来需要跳下悬崖才能看到","l":"zh-CN"},{"p":"","o":"位于半空，靠近直接一个钩索获取","l":"zh-CN"},{"p":"","o":"位于半空","l":"zh-CN"},{"p":"","o":"位于靠近地面的半空中，如果传送到附近的信标，需要先到悬崖边跳到最底下，再飞到标点位置才能看到","l":"zh-CN"},{"p":"","o":"位于半空，靠近一个钩索获取","l":"zh-CN"},{"p":"","o":"位于路边的建筑上方","l":"zh-CN"},{"p":"","o":"位于靠近地面的树顶部","l":"zh-CN"},{"p":"","o":"位于建筑顶端","l":"zh-CN"},{"p":"","o":"位于小岛的最高处","l":"zh-CN"},{"p":"","o":"位于山体之间，飞起来用钩索获取","l":"zh-CN"},{"k":"일종의 신기한 공공 에코, 선율과 박자에 관해 타고난 재능이 있다. 악보만 제공하면, 하루살이 밴드를 지휘하여 어떤 곡이든 연주할 수 있다"},{"k":"해당 적은 전도 피해 저항이 증가한다.\n해당 적은 인멸 피해 저항이 증가한다.\n의태 토우, 거짓의 신왕은 흑조(黑潮)의 군집이 만들어낸 잔상이다.\n검은 진흙의 형태를 띤 그것은 명식이 구상한 「융합」의 유토피아에서 탄생했다. 그의 왕관 아래는 텅텅 비어있으며, 그저 「포식」에 쓰이는 용기일 뿐이었다. 만물은 신왕의 뱃속에서 하나로 융합하여 레비아탄의 신하와 백성, 아이로 다시 태어날 것이다.\n그것은 사상도 감각도 없다. 흐르는 검은 진흙만이 진동하며 거짓의 찬가를 연주하고 레비아탄의 힘을 영원히 찬양하고 있다"},{"p":"","o":"完成挑战一可获得潮汐之遗紫，完成挑战二与三可获得潮汐之遗金各一个与两个（挑战开启交互点需靠近剑亮处一侧，不然有点难按到 位置位于下方请注意）","l":"zh-CN"},{"p":"","o":"完成挑战一可获得潮汐之遗紫，完成挑战二与三可获得潮汐之遗金各一个与两个（挑战开启交互点需靠近剑亮处一侧，不然有点难按到）","l":"zh-CN"},{"p":"","o":"完成挑战一可获得潮汐之遗紫，完成挑战二与三可获得潮汐之遗金各一个与两个（挑战开启交互点需靠近剑亮处一侧，不然有点难按到 位置在下方请注意）","l":"zh-CN"},{"p":"","o":"需完成三处烬潮之梦的九次挑战后才可挑战，完成挑战一可获得潮汐之遗紫，完成挑战二与三可获得潮汐之遗金各一个与两个（挑战开启交互点需靠近剑亮处一侧，不然有点难按到）","l":"zh-CN"},{"p":"","o":"在标点附近水池触碰光点可获得基准宝箱","l":"zh-CN"},{"p":"","o":"做好准备击败吧！首次击败后可获得潮汐之遗金","l":"zh-CN"},{"p":"","o":"以第二张图总督面对方向为基准，宝箱在总督前方梯子的右手边，面前那个大宝箱击杀三次给一个辉光。（感谢各位玩家提供辉光宝箱获取方法。）","l":"zh-CN"},{"p":"","o":"以第二张图总督面对方向为基准，宝箱在总督前方梯子的左手边，被草丛挡住了，面前那个大宝箱击杀三次给一个辉光。（感谢各位玩家提供辉光宝箱获取方法。）","l":"zh-CN"},{"p":"","o":"以第三张图总督位置为基准，宝箱在总督右手边，走过去，就可以看到。","l":"zh-CN"},{"p":"","o":"以第二张图总督位置为基准，爬上右手边的建筑，爬到最高处，就可以看到宝箱。","l":"zh-CN"},{"p":"","o":"第二张图总督的位置，她的左手边的台子上，爬上去，就能看到宝箱。","l":"zh-CN"},{"p":"","o":"站在第二张图总督的位置上，她正面面对的墙的后方，就是宝箱，可以从右手边绕过去，朝着声匣位置走，就能看到一个小道。","l":"zh-CN"},{"p":"","o":"以第二张图总督位置为基准，宝箱在总督右手边的的建筑上方，也就是声匣顶上的一个柱子上。","l":"zh-CN"},{"p":"","o":"站在总督第二张图的位置，先爬上总督左手边的木台子，然后在爬上建筑，就能找到宝箱。","l":"zh-CN"},{"p":"","o":"在第二张图总督面前的柱子的台子上，传送到信标之后，朝着楼梯下来，就能来到第二张图的位置。","l":"zh-CN"},{"p":"","o":"总督面对的废弃船体下面，有几个箱子当着，那后面就是宝箱。","l":"zh-CN"},{"p":"","o":"在第二张图，总督面对的从船体废墟中，有一些箱子挡在前面，宝箱就在箱子后面。","l":"zh-CN"},{"p":"","o":"来到藏宝地之后，先站在第二张图的位置，然后朝着总督右手边的位置走，就能看到宝箱。","l":"zh-CN"},{"p":"","o":"先站在第二张图的位置，然后来到总督右手边的柱子边，最后爬上去，就能看到宝箱。","l":"zh-CN"},{"p":"","o":"第二张图，总督左手边，图中左边最近的那根柱子，爬上去，就能看到宝箱。","l":"zh-CN"},{"p":"","o":"以第三张图总督站的位置为基准，左手边是精密宝箱，右手边是基准宝箱，正面面对的山体后面还有两个基准宝箱。","l":"zh-CN"},{"p":"","o":"瀑布边缘。","l":"zh-CN"},{"p":"","o":"过主线可开启，但是不一定，有的人会错过","l":"zh-CN"},{"p":"","o":"依旧以第二张图位置面对建筑为路标，朝总督左手边走，开一下扫描，很快就能找到。","l":"zh-CN"},{"p":"","o":"以第二张图总督站的位置为基准，左手边有两个基准宝箱，分别在左手边下面的草丛里，和左手边爬上小山体上方；右手边，有一个基准宝箱和一个精密宝箱，基准宝箱在左手边小山体上方，精密宝箱在左手边地面位置。","l":"zh-CN"},{"p":"","o":"因为我不能用翱翔，所以我采取了最古老的方法，跑过来。爬上四方殿那里，然后一路朝这条山脉走。","l":"zh-CN"},{"p":"","o":"以第二张图总督站的位置为基准，总督右手边的大树根部有一个基准宝箱，左手边大树树枝上有一个基准宝箱，总队正面面对方向，走几步就能看到一个基准宝箱，总督左手边的平台上，有一个精密宝箱，需要清小怪。","l":"zh-CN"},{"p":"","o":"四方殿的信标传送过来之后，爬上四方殿楼顶，就能找到这个宝箱。","l":"zh-CN"},{"p":"","o":"完成纪闻任务《以呼啸致意》任务时可开启（标点由玩家改文件用提供）","l":"zh-CN"},{"p":"","o":"完成纪闻任务《朽剑之梦》任务时可开启（标点由玩家改文件用提供）","l":"zh-CN"},{"p":"","o":"和水池互动一下，过一小段剧情，就可以获得宝箱。","l":"zh-CN"},{"p":"","o":"和水池光点互动一下，过一小段剧情，就可以获得宝箱。","l":"zh-CN"},{"k":"표시 근처를 조사하면 상자가 나타난다. 아래쪽 구역이니 헷갈리지 말 것 (먼저 P2에서 우타타 숨겨진 임무를 받아야 상호작용 가능! P3는 게임 내 임무 수락 장소)"},{"p":"","o":"完成任务朽剑之梦时可开启（标点由玩家改文件用提供）","l":"zh-CN"},{"p":"25층","o":"完成2.6版本主线任务途中可开启（标点由玩家改文件用提供）","l":"zh-CN"},{"p":"23층","o":"完成《今夜，注定属于月亮》主线任务时可开启","l":"zh-CN"},{"p":"","o":"地方比较高，直接飞上来就可以。","l":"zh-CN"},{"p":"","o":"三王峰上方的位置，飞上来之后开一下扫描，很容易就可以找到。","l":"zh-CN"},{"p":"","o":"宝箱在第二张图嘉贝面对的箱子后面，飞到三王峰的广场后，站到嘉贝第三张图的位置，然后向右转，直走，就可以看到。第一次来到广场，会和红名狮象战斗。","l":"zh-CN"},{"p":"","o":"宝箱在第二张图狮象雕像的后面，飞到三王峰之后，会进入战斗，战斗之后，顺着第三张图直走，来到狮象面前，走到后面就能看到。第二张图的辉光宝箱，是打败狮象之后，来到这里，有个互动光点，可以进行互动，就会出来这个宝箱。","l":"zh-CN"},{"p":"","o":"宝箱在第二张图，正对方向的剑士石像的手中，飞到三王峰广场之后，顺着第三张图的正对方想，直走就行。第一次来的时候，会进入战斗，和狮象打一架。","l":"zh-CN"},{"p":"","o":"宝箱在第二张图，正对方向的剑士石像的右肩膀上，飞到三王峰广场之后，顺着第三张图的正对方想，直走就行。第一次来的时候，会进入战斗，和狮象打一架。","l":"zh-CN"},{"p":"","o":"宝箱在第二张图，正对方向的剑士石像的左肩膀上，飞到三王峰广场之后，顺着第三张图的正对方想，直走就行。第一次来的时候，会进入战斗，和狮象打一架。","l":"zh-CN"},{"p":"","o":"宝箱在第二张图，剑士石像的剑后面。来到第三张图的位置，然后朝左手边走，就可以看到石像。第一次来的时候，会进入战斗，和狮象打一架。","l":"zh-CN"},{"p":"","o":"宝箱在第二张图箱子后面，飞到三王峰广场中央，也就是第三张图的位置，第一次来的时候，会进入战斗。第三张图的位置向左转，然后一直走，就能看到。","l":"zh-CN"},{"p":"","o":"宝箱在第二张图，剑士石像的剑后面。来到第三张图的位置，然后朝右手边走，就可以看到石像。第一次来的时候，会进入战斗，和狮象打一架。","l":"zh-CN"},{"p":"","o":"宝箱在第二张图，正对方向的剑士石像的腰后边，飞到三王峰广场之后，顺着第三张图的正对方向，直走就行。第一次来的时候，会进入战斗，和狮象打一架。","l":"zh-CN"},{"p":"","o":"传送到翱翔挑战·四这里，然后转头向后走，就能看到。","l":"zh-CN"},{"p":"","o":"这个宝箱在三王峰上，朝着标点位置飞上来，开个扫描，很快就能找到，很明显的位置。","l":"zh-CN"},{"p":"","o":"这个位置不太好描述，这个标点几乎重复的一个坐标，在三王峰上，也有一个宝箱，以三王峰的那个宝箱为基准，垂直下降，就能看到这个宝箱。","l":"zh-CN"},{"p":"","o":"需要清小怪。","l":"zh-CN"},{"p":"","o":"找一下第二张图左边的雕像，或者在这附近开扫描，很快就能找到宝箱。","l":"zh-CN"},{"p":"","o":"以第三张图为总督站的位置为基准，爬上总督面对建筑的第三层位置，宝箱在第二张图总督正面面对的草丛里面。","l":"zh-CN"},{"p":"25층","o":"完成2.6版本主线任务后可开启宝箱","l":"zh-CN"},{"p":"","o":"能直接开 开了就跑","l":"zh-CN"},{"p":"","o":"把周围杂物清理就可以出现宝箱。（感谢反馈此点位玩家）","l":"zh-CN"},{"p":"","o":"供奉三个铛铛蟹就可以啦。","l":"zh-CN"},{"p":"25층","o":"过2.6版本主线剧情时可顺路开启","l":"zh-CN"},{"p":"","o":"在标点附近调查后出现宝箱 位置在下方区域不要搞错咯（需先在P2处接取乌塔塔隐藏任务后才可交互！P3是游戏内接任务的地方）完成系列任务可获得成就【找到你了哦，呜獭獭】","l":"zh-CN"},{"p":"","o":"此宝箱在标点位置的下方，也就是三王峰外围，不在三王峰盯上。（标点由玩家进击的路人甲、云不才、Mira提供）","l":"zh-CN"},{"p":"","o":"完成隐藏任务不死的角斗士后可获得（P2为任务一图流，由攻略作者Lee小坏制作）","l":"zh-CN"},{"p":"","o":"来到该标点东侧（P2空地处）击败100级红名强敌【荣耀狮像·永燃冠冕】后可开启，顺便完成成就【先王的考验】","l":"zh-CN"},{"p":"24층","o":"需完成以呼嚎致意前置任务后开启入口","l":"zh-CN"},{"k":"25층"},{"k":"26층"},{"k":"27층"},{"p":"23층","o":"静思所分层入口（完成《今夜，注定属于月亮》主线任务时可开启）","l":"zh-CN"},{"p":"","o":"击败标点附近怪物后可获得","l":"zh-CN"},{"p":"","o":"击败标点附近红名怪后可获得","l":"zh-CN"},{"p":"","o":"需先完成三处烬潮之梦共九次挑战后才可挑战，完成挑战二与三可获得潮汐之遗金各一个与两个（挑战开启交互点需靠近剑亮处一侧，不然有点难按到）","l":"zh-CN"},{"p":"","o":"完成烬潮之梦挑战二与三可获得潮汐之遗金各一个与两个（挑战开启交互点需靠近剑亮处一侧，不然有点难按到 位置位于下方请注意）","l":"zh-CN"},{"p":"","o":"完成烬潮之梦挑战二与三可获得潮汐之遗金各一个与两个（挑战开启交互点需靠近剑亮处一侧，不然有点难按到）","l":"zh-CN"},{"p":"","o":"击败三王峰红名怪【没世裁断】后解锁，并完成成就【逆转裁断】（特别提醒：标点位置不在地面上，位于半空中的平台上哦）","l":"zh-CN"},{"p":"","o":"需完成三处烬潮之梦的九次挑战后才可挑战，完成挑战一可获得潮汐之遗紫（挑战开启交互点需靠近剑亮处一侧，不然有点难按到）","l":"zh-CN"},{"p":"","o":"完成烬潮之梦挑战一可获得潮汐之遗紫（挑战开启交互点需靠近剑亮处一侧，不然有点难按到 位置位于下方请注意）","l":"zh-CN"},{"p":"","o":"完成烬潮之梦挑战一可获得潮汐之遗紫（挑战开启交互点需靠近剑亮处一侧，不然有点难按到）","l":"zh-CN"},{"k":"해당 지역은 매일 일정 수의 악몽 잔상이 갱신되며, 악몽 잔상을 격파한 후에는 특정 악몽 에코를 획득할 수 있다"},{"k":"해당 지역은 매일 일정 수의 악몽 잔상이 갱신되며, 악몽 잔상을 격파한 후에는 특정 악몽 에코를 획득할 수 있다"},{"p":"","o":"三王峰梦魇聚落，掉落套装：焚羽猎魔之影","l":"zh-CN"},{"p":"","o":"该藏宝地共4处宝箱 可通过大地图或游戏内通过【感知】查找（该藏宝地不包括一个辉光宝箱，可通过大地图得知宝箱位置和开启办法）","l":"zh-CN"},{"k":"이 보물 지점에는 보물상자가 4곳 있다. 큰 지도나 게임 내 [스캔]로 찾을 수 있다."},{"k":"이 보물 지점에는 보물상자가 5곳 있다. 큰 지도나 게임 내 [스캔]로 찾을 수 있다."},{"p":"","o":"该藏宝地共4处宝箱 可通过大地图或游戏内通过【感知】查找（有一精密宝箱位于塔楼上方请注意）","l":"zh-CN"},{"p":"","o":"该藏宝地共4处宝箱 可通过大地图或游戏内通过【感知】查找（该藏宝地范围较大 可结合大地图宝箱位置寻找）","l":"zh-CN"}],"markers":[["1425592199682535424",0,19900.1,23382.1,"0",-1],["1425592850365886464",0,19778.9,23171.7,"0",-1],["1425592923724263424",0,19782.4,23178.2,"0",-1],["1425593882714124288",1,19853.4,23068.9,"0",-1],["1421447049515446272",2,19841.5,23427.6,"0",0],["1425585220176130048",3,20095.6,23189.7,"0",-1],["1425585294096543744",3,20083.6,23193.2,"0",-1],["1425592061576687616",3,19911.5,23381.1,"0",-1],["1425592085882679296",3,19906.1,23384.0,"0",-1],["1425593011276165120",3,19775.7,23168.5,"0",-1],["1425594365453348864",3,19940.2,23066.5,"0",-1],["1425594393538408448",3,19931.1,23061.0,"0",-1]