"id":"CS_02","n":"소형 비콘","g":"exploration","c":"#6cc8ee","i":"tiles/icons/ace53ba2750c41850ccd.webp"},{"id":"CS_01","n":"중추 비콘","g":"exploration","c":"#9fdb72","i":"tiles/icons/35bb0bb1bbd2f285b3bf.webp"},{"id":"310000830","n":"아이스글린트 댄서","g":"enemies","c":"#8bd3c7","i":"tiles/icons/7bef31083c232e6bcedb.webp"}],"def":["qzx_02","qzx_03","qzx_01","qzx_04"],"layers":[{"id":"-1/44","n":"스카이아크","gid":"44","gn":"스카이아크","t":{"src":"tiles/layers/8/-1_44/{x}_{y}.webp","tileSize":768,"columns":30,"rows":31,"availableTiles":["10,-25","10,-26","11,-25","11,-26","12,-25","12,-26"],"ext":["12,-25","12,-26","11,-25","11,-26","10,-25","10,-26"]}},{"id":"-3/44","n":"실험 구역 1 · 스카이아크","gid":"44","gn":"스카이아크","t":{"src":"tiles/layers/8/-3_44/{x}_{y}.webp","tileSize":768,"columns":30,"rows":31,"availableTiles":["11,-25","11,-26"],"ext":["11,-26","11,-25"]}},{"id":"-4/44","n":"실험 구역 2 · 스카이아크","gid":"44","gn":"스카이아크","t":{"src":"tiles/layers/8/-4_44/{x}_{y}.webp","tileSize":768,"columns":30,"rows":31,"availableTiles":["11,-25","11,-26"],"ext":["11,-26","11,-25"]}},{"id":"-1/45","n":"관측소 터널","gid":"45","gn":"얼어붙은 동굴","t":{"src":"tiles/layers/8/-1_45/{x}_{y}.webp","tileSize":768,"columns":30,"rows":31,"availableTiles":["11,-25"],"ext":["11,-25"]}}],"descs":[{"p":"","o":"位于冰原半山腰的空中，可以通过图2的信标，开着摩托沿天槎空间站地表部分开到终声残卷所在的山上","l":"zh-CN"},{"p":"","o":"位于冰原的山崖边，可以通过图2所示信标，开摩托沿着天槎空间站地表部分开上终声残卷所在的山体，再往目标方向前进","l":"zh-CN"},{"p":"","o":"在雪山最高的顶峰处","l":"zh-CN"},{"p":"","o":"在山洞的半空中","l":"zh-CN"},{"p":"","o":"在高处雪山的山尖处","l":"zh-CN"},{"p":"","o":"位于天槎空间站地表中心部分建筑的缝隙处","l":"zh-CN"},{"p":"","o":"位于半空中，可使用附近的模块架构器接近 就在主线进太空站，架构的绿色道路上","l":"zh-CN"},{"k":"공중에 있음"},{"p":"","o":"坐在日灵旁边，过一会起身和日灵对话","l":"zh-CN"},{"p":"44층","o":"需要使用显像功能，显像格洛犸图声骸，一个精密、一个日灵。","l":"zh-CN"},{"k":"해당 구역에서는 매일 일정 수량의 잔상이 리셋된다. 군락 내의 잔상을 격파 후, 일정한 확률로 해당되는 에코 세트가 드랍된다"},{"k":"44층"},{"p":"","o":"先看第二张图，小爱对面的悬崖，从左到右，分别是基准、基准、朴素；之后，从第二张图的位置小跳下去，脚下还有两个宝箱，左边是朴素，右边是基准。使用鹰眼无人机开启就好，手动开宝箱，太麻烦了。","l":"zh-CN"},{"p":"","o":"来看第二张图，小爱面前一个朴素宝箱，右手边方框位置，开扫描走下去，有一个朴素；正面对面的远点，有一个基准，左手边两个方框位置，有两个基准宝箱，具体情况请看第三张图。用鹰眼无人机就好，手动开宝箱太折磨人了。","l":"zh-CN"},{"p":"","o":"宝箱分布比较散落，没办法一张图全部展示，大家直接用鹰眼一键扫描开启就好，我为大家说一下宝箱具体位置。首先，大柱子中央表面有一个朴素，在这个朴素下面的夹层，有一个基准，小心别掉下去，如图第一张图；接着看第二张图，孔洞位置和悬崖位置各有一个基准；最后第三张图，孔洞位置有一个朴素。","l":"zh-CN"},{"k":"적을 처치해야 한다."},{"k":"바이크 챌린지 상자. 챌린지 장소는 두 번째 그림의 네모 표시 위치 참고."},{"k":"바이크 챌린지 상자. 챌린지 장소는 두 번째 그림의 네모 표시 위치."},{"k":"「태양의 정령을 이끄는 자」 챌린지 상자."},{"p":"","o":"第一次来到这里的时候，会看到小爱对面的岸上有一个先遣队队员被怪物围攻，清怪，会接到拔探测器的任务，拔完之后在对话，就有这个宝箱。","l":"zh-CN"},{"p":"45층","o":"此处需要用摩托跳上来，摩托跳跃地点在第三张图的位置，之后，显像格洛犸图声骸，就会出现三个宝箱。","l":"zh-CN"},{"p":"","o":"摩托挑战宝箱，小难，具体位置请看第三张图。","l":"zh-CN"},{"p":"","o":"此处是一个小任务，第一次来这里的情况下，小爱对面的海滩边会有一个先遣队员，触发一个跟着日灵的任务，然后拔一下探测器，就可以了。","l":"zh-CN"},{"p":"","o":"摩托挑战宝箱，挑战地点就在标点位置，失败五次可解锁强制结算。第二个坡的门直接跳飞过去，第三道坡的门一样","l":"zh-CN"},{"p":"","o":"使用显像功能，显像格洛犸图声骸，同时打开宝箱会接取冰原往事任务。","l":"zh-CN"},{"p":"44층","o":"传送到第三张图方框信标，右转视角，就能看到。","l":"zh-CN"},{"p":"44층","o":"传送到第三张图方框信标，视角右转，就能看到。","l":"zh-CN"},{"p":"44층","o":"传送到距标点最近的信标，然后拿上第三张图方框位置的模型架构器，就可以进来这个房间。","l":"zh-CN"},{"p":"","o":"此处最开始是一堆冰锥，使用显像功能，显像声骸格洛犸图，之后会出现一个NPC，和她对话，就可以获得宝箱。(如果显像不行就退后两步再放)","l":"zh-CN"},{"p":"46층","o":"“观测廊道”分层入口","l":"zh-CN"},{"p":"","o":"藏宝地，五个宝箱","l":"zh-CN"},{"k":"44층 · 3마리가 함께"},{"p":"","o":"下方洞内两只一起","l":"zh-CN"},{"p":"","o":"两只一起与流民交战","l":"zh-CN"},{"p":"","o":"巨岩下，冠顶苍隼处","l":"zh-CN"},{"p":"","o":"三个在一起守着潮汐之遗","l":"zh-CN"},{"p":"","o":"三个在一起与冠顶械隼交战","l":"zh-CN"},{"p":"","o":"半山腰冰路处，两只在一起","l":"zh-CN"}],"markers":[["1469130068059607040",0,8691.0,5228.7,"0",-1],["1469130068164464640",0,8690.1,5227.8,"0",-1],["1469130068277710848",0,8686.5,5226.9,"0",-1],["1469130068382568448",0,8687.4,5225.1,"0",-1],["1469711829911257088",0,8701.9,5179.9,"0",-1],["1469711830074834944",0,8702.8,5179.9,"0",-1],["1469711830238412800",0,8704.6,5179.9,"0",-1],["1469711830401990656",0,8704.6,5181.7,"0",-1],["1469711830561374208",0,8705.5,5179.9,"0",-1],["1469711830729146368",0,8707.3,5179.9,"0",-1],["1469713030866128896",0,8676.6,5183.5,"0",-1],["146971303097518