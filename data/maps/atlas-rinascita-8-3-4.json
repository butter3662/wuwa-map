봉선화","g":"resources","c":"#f07e83","i":"tiles/icons/6d4e0ea045e346c4b48c.webp"},{"id":"cbd","n":"보물 지점","g":"exploration","c":"#6cc8ee","i":"tiles/icons/5111afe1ca71aba1d1e3.webp"},{"id":"CS_02","n":"소형 비콘","g":"exploration","c":"#9fdb72","i":"tiles/icons/ace53ba2750c41850ccd.webp"},{"id":"SP_IconMonsterHead_31044_UI","n":"구름 바다 요정","g":"enemies","c":"#8bd3c7","i":"tiles/icons/9e511c8d358166759ece.webp"},{"id":"CS_01","n":"중추 비콘","g":"exploration","c":"#f8c963","i":"tiles/icons/35bb0bb1bbd2f285b3bf.webp"},{"id":"sxdtz","n":"삼형제 도전","g":"exploration","c":"#b8a1ff","i":"tiles/icons/126c86cc5d390706ea29.webp"},{"id":"llsr","n":"블레이드 듀오","g":"elite-enemies","c":"#f07e83","i":"tiles/icons/14454ea463320d7440c3.webp"}],"def":["qzx_02","qzx_03","qzx_01","qzx_04"],"layers":[{"id":"-1/10","n":"애도 성역 · 아래층","gid":"10","gn":"애도 성역 · 아래층","t":{"src":"tiles/layers/8/-1_10/{x}_{y}.webp","tileSize":768,"columns":30,"rows":31,"availableTiles":["22,-11"],"ext":["22,-11"]}}],"descs":[{"p":"","o":"位于洞穴中，从北侧洞口进入","l":"zh-CN"},{"k":"언덕 위 1개"},{"p":"","o":"草地上和树下各一个","l":"zh-CN"},{"k":"2개"},{"k":"절벽 가장자리 1개"},{"p":"","o":"草丛边一个（不小心采了）","l":"zh-CN"},{"p":"","o":"信标边一个","l":"zh-CN"},{"k":"절벽 가장자리 3개"},{"k":"총 3개"},{"k":"길가에 1개"},{"k":"나무 아래 1개"},{"p":"","o":"墙边一个","l":"zh-CN"},{"p":"","o":"门口一个","l":"zh-CN"},{"k":"풀밭에 1개"},{"p":"","o":"图中红框处贴近墙攻击即可获取","l":"zh-CN"},{"k":"알맞은 '몸'을 끊임없이 찾는 잔상으로, 유령 인형의 '오른손' 역할을 맡는다."},{"p":"","o":"偶遇骑士大战布偶熊，拼尽全力，无法战胜。","l":"zh-CN"},{"k":"알맞은 '몸'을 끊임없이 찾는 잔상으로, 유령 인형의 '왼손' 역할을 맡는다."},{"p":"","o":"小心，这个声匣下面有个大眼怪。","l":"zh-CN"},{"p":"10층","o":"传送到上方，信标往右转，有一个往下的楼梯走下去就找到了（别掉下去，下面是红名怪）","l":"zh-CN"},{"p":"","o":"距离最近的传送锚点右后方直走最高点的废墟上","l":"zh-CN"},{"p":"","o":"这处废墟不是很好爬，可以跳跃起手，然后钩锁跟上，最后二段跳，找个平台。也可以直接起飞上去","l":"zh-CN"},{"p":"","o":"在一个破旧废墟的二楼","l":"zh-CN"},{"p":"","o":"峡谷中央","l":"zh-CN"},{"p":"","o":"左边信标往这个方向走，下楼梯右边","l":"zh-CN"},{"p":"","o":"标记点下方有个洞穴，石桥下的瀑布中央。","l":"zh-CN"},{"p":"","o":"去路边跳下去开滑翔（标点有误，图2和图3是准确位置）","l":"zh-CN"},{"p":"","o":"塔楼上空","l":"zh-CN"},{"p":"","o":"悬崖旁边的建筑不要飞过头了","l":"zh-CN"},{"k":"처음으로 노드 목표 3개를 완료하면 조석의 유산 3개 획득"},{"k":"알맞은 '몸'을 끊임없이 찾는 잔상들"},{"k":"별빛 박쥐를 놀라게 하거나 처치하면 얻는다."},{"p":"","o":"信标路对面一个","l":"zh-CN"},{"k":"나무 아래 2개"},{"k":"덤불 옆 1개"},{"k":"풀밭에 2개"},{"p":"","o":"碎石堆边两个","l":"zh-CN"},{"p":"","o":"路边大石头旁一个","l":"zh-CN"},{"p":"","o":"山坡下一个","l":"zh-CN"},{"p":"","o":"楼梯边一个","l":"zh-CN"},{"p":"","o":"山坡一个","l":"zh-CN"},{"p":"","o":"桥头一个","l":"zh-CN"},{"p":"","o":"悬崖边树下一个","l":"zh-CN"},{"p":"","o":"位于传送点往南方向的地面，解法可参考图2，按照颜色顺序点击箭头所指位置即可","l":"zh-CN"},{"p":"","o":"位于遗颂河谷西侧水路的尽头。解法可参考图2，按照颜色顺序点击箭头所指位置即可","l":"zh-CN"},{"k":"그림 2 참고. 색깔 순서대로 화살표가 가리키는 위치를 누르면 된다."},{"p":"","o":"三个在一起处于道路两边","l":"zh-CN"},{"p":"","o":"在上层道路边","l":"zh-CN"},{"p":"","o":"上层路边树下","l":"zh-CN"},{"p":"","o":"两个在湖边同类决斗","l":"zh-CN"},{"p":"","o":"上层地面，绘画西面","l":"zh-CN"},{"p":"","o":"上层地面，绘画西边，靠近后会从虚空中出现","l":"zh-CN"},{"k":"꿈의 노드로 구성된 네트워크에 숨겨져 있는 특수 잔상, 어떤 부정적인 감정이 모여 있는 주파수이다"},{"p":"","o":"在限定时间内躲避琉璃刀伶即可完成挑战 首次完成后可获得基准宝箱","l":"zh-CN"},{"p":"","o":"布偶熊家族守着","l":"zh-CN"},{"k":"근처 적을 처치하면 열린다."},{"p":"","o":"击败附近怪物后解锁","l":"zh-CN"},{"p":"","o":"位于南部桥下，击败附近怪物后解锁（位置比较不好找）","l":"zh-CN"},{"p":"","o":"与中间的柱子互动开启【全息战略·刀伶之舞】，完成挑战后可获得（标点由玩家Seyra提供）","l":"zh-CN"},{"p":"","o":"击碎所有石块后出现。\n[Tọa độ 8415, 5355, 71] Vị trí dấu chấm câu hiện tại không chính xác.","l":"zh-CN"},{"p":"","o":"击杀前方幻昼骑士后解锁","l":"zh-CN"},{"p":"","o":"击败周围敌人后解锁","l":"zh-CN"},{"p":"","o":"位于南部桥下，击败附近怪物后解锁","l":"zh-CN"},{"p":"","o":"与此处npc对话，完成书页收集出现。","l":"zh-CN"},{"p":"","o":"如图所示，先将标点附近4个石碑拉到图中位置，再在图中的5处变身，来到石碑中间吸收噩梦乌云，吸收完后在来和沃德戈（图二位置）对话后出现宝箱（标点由玩家雲开提供）","l":"zh-CN"},{"p":"","o":"传送到挑战这个位置，朝着第二张图，二小姐正对的方向走，爬上那个小废墟，墙后面有个小洞，跳下去就可以找到。","l":"zh-CN"},{"p":"","o":"传送到此标点右边的信标，来到这里会看到残星会，但是做不做掉都没关系，这附近有三个宝箱，紫宝箱旁边还有个宝箱怪，朴素宝箱在帐篷后面。","l":"zh-CN"},{"p":"","o":"这里有一群布偶熊和宝箱怪镇守，但这个朴素宝箱，藏在第二张图这个位置的正对方向，原本有一堆木箱子挡着，全部打掉就可以找到。","l":"zh-CN"},{"p":"","o":"在房子和树的夹缝中，箱子前边还有个木箱子，打碎就能看到。","l":"zh-CN"},{"p":"","o":"在屋顶的烟囱背面。","l":"zh-CN"},{"p":"","o":"在下方河道处，千万不要被美丽的宝箱欺骗了哦，那是个宝箱怪。","l":"zh-CN"},{"p":"","o":"这个宝箱有点隐秘，宝箱的边上，被两个蓝色石块挡住，所以不容易发现，靠近之后变成布偶熊打碎。","l":"zh-CN"},{"p":"","o":"草丛边上有个调查，点击一下，就出现了。（来到这个宝箱富集点之后，建议开感知，除了这个调查的宝箱，其余三个宝箱，都很容易发现。）","l":"zh-CN"},{"p":"","o":"地方应该不难找，来到这里之后，清一下怪物，宝箱在第二张图帐篷的后面。","l":"zh-CN"},{"p":"","o":"1-来到第二张图的位置，这个帐篷后面还有一个朴素宝箱，爬上二小姐正对方向的瀑布悬崖，走到瀑布边上，走进去就能看到宝箱；\n2-能来这里找宝箱，大概率都是从此标点西北方向的信标走过来的，那么必然会有跳下悬崖的动作，别跳到最下方，第三张图悬崖边上有跳跳熊位置，沿着悬崖走到瀑布边上。","l":"zh-CN"},{"p":"","o":"传送到赞悼圣迹的信标，朝着石桥这边走，走到差不多和标点重合的位置后，开着滑翔伞跳下来，千万别一股脑直接下去。","l":"zh-CN"},{"p":"","o":"宝箱被蓝色石块挡住，靠近之后变成布偶熊砸碎就好。","l":"zh-CN"},{"p":"","o":"建议先清怪，宝箱在最大的屋子后面.","l":"zh-CN"},{"p":"","o":"裸露在外，用布偶熊打碎即可\n(坐标8129，5430，28 标点位置有误）","l":"zh-CN"},{"p":"","o":"位于布偶乐团中心，调查出现，三只工头布偶、一只巨布偶。","l":"zh-CN"},{"p":"","o":"可直接开启，位于建筑二楼平台处","l":"zh-CN"},{"p":"","o":"于怪物挖掘点位调查后出现。","l":"zh-CN"},{"p":"","o":"于怪物中心调查出现。","l":"zh-CN"},{"p":"","o":"在海边，变身布偶熊摧毁周围的石块后出现宝箱（标点由玩家Seyra提供）","l":"zh-CN"},{"p":"","o":"与布偶旁的闪光点交交互出现","l":"zh-CN"},{"p":"","o":"在标点附近通过调查并战斗两次后获得（标点由玩家silent提供）第一次是三只欺诈奇藏，击败之后会出现一个假的欺诈奇藏，再次击败会会让你挖一次就会有宝箱了","l":"zh-CN"},{"k":"표시 주변을 떠도는 반딧불. 방랑자여, 잡아라!"},{"k":"화려한 의상을 입고 날카로운 칼을 든 인간형 의태 잔상. 전설에서나 존재할 법한 강력한 전투력을 자랑한다"},{"p":"","o":"这个塔的废墟里","l":"zh-CN"},{"p":"","o":"在村子南方塔下，击杀后解锁紫色奇藏箱","l":"zh-CN"},{"k":"10층"},{"p":"","o":"完成【巡礼之梦·破碎刀伶之心】一个节点目标可解锁","l":"zh-CN"},{"p":"","o":"完成【巡礼之梦·圣迹的梦境枢纽】挑战时，枢纽不被摧毁即可解锁","l":"zh-CN"},{"p":"","o":"完成【巡礼之梦·布偶游行】一个节点目标可解锁","l":"zh-CN"},{"p":"","o":"完成【巡礼之梦·快乐布偶朋友】一个节点目标可解锁","l":"zh-CN"},{"p":"","o":"完成【巡礼之梦·破碎刀伶之心】三个节点目标可解锁","l":"zh-CN"},{"p":"","o":"完成【巡礼之梦·快乐布偶朋友】三个节点目标可解锁","l":"zh-CN"},{"p":"","o":"完成【巡礼之梦·布偶游行】三个节点目标可解锁","l":"zh-CN"},{"p":"","o":"完成【巡礼之梦·圣迹的梦境枢纽】挑战时，枢纽完整度大于60%可解锁","l":"zh-CN"},{"p":"10층","o":"击败红名怪【琉璃双刃】可解锁","l":"zh-CN"},{"p":"","o":"完成【巡礼之梦·布偶游行】两个节点目标可解锁","l":"zh-CN"},{"p":"","o":"完成【巡礼之梦·快乐布偶朋友】两个节点目标可解锁","l":"zh-CN"},{"p":"","o":"完成【巡礼之梦·圣迹的梦境枢纽】挑战时，枢纽完整度大于30%可解锁","l":"zh-CN"},{"p":"","o":"完成【巡礼之梦·破碎刀伶之心】两个节点目标可解锁","l":"zh-CN"},{"p":"","o":"秘境挑战门口处，共六个","l":"zh-CN"},{"p":"","o":"河边三个","l":"zh-CN"},{"k":"이 구역에 총 12개"},{"