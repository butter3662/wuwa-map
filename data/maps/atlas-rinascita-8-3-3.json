"cx_01","n":"조석의 유산 · 초록","g":"collection","c":"#f8c963","i":"tiles/icons/1b956f2f5d2ab8f86ef4.webp"},{"id":"cx_03","n":"조석의 유산 · 금","g":"collection","c":"#b8a1ff","i":"tiles/icons/0c7537783a162a18228c.webp"},{"id":"cx_02","n":"조석의 유산 · 보라","g":"collection","c":"#f07e83","i":"tiles/icons/59f0eaade75ad1457a7e.webp"},{"id":"cbd","n":"보물 지점","g":"exploration","c":"#6cc8ee","i":"tiles/icons/5111afe1ca71aba1d1e3.webp"},{"id":"CS_02","n":"소형 비콘","g":"exploration","c":"#9fdb72","i":"tiles/icons/ace53ba2750c41850ccd.webp"},{"id":"SP_IconMonsterHead_31044_UI","n":"구름 바다 요정","g":"enemies","c":"#8bd3c7","i":"tiles/icons/9e511c8d358166759ece.webp"},{"id":"CS_01","n":"중추 비콘","g":"exploration","c":"#f8c963","i":"tiles/icons/35bb0bb1bbd2f285b3bf.webp"},{"id":"sxdtz","n":"삼형제 도전","g":"exploration","c":"#b8a1ff","i":"tiles/icons/126c86cc5d390706ea29.webp"}],"def":["qzx_02","qzx_03","qzx_01","qzx_04"],"layers":[{"id":"-1/8","n":"달빛의 바다 동굴","gid":"8","gn":"달빛의 바다 동굴","t":{"src":"tiles/layers/8/-1_8/{x}_{y}.webp","tileSize":768,"columns":30,"rows":31,"availableTiles":["22,-12"],"ext":["22,-12"]}},{"id":"-1/9","n":"우인 낙원","gid":"9","gn":"우인 낙원","t":{"src":"tiles/layers/8/-1_9/{x}_{y}.webp","tileSize":768,"columns":30,"rows":31,"availableTiles":["22,-12"],"ext":["22,-12"]}}],"descs":[{"p":"","o":"位置有误","l":"zh-CN"},{"p":"","o":"纪闻任务失落之影途中完成（可查看对应攻略,首次完成可获得基准宝箱）","l":"zh-CN"},{"p":"","o":"纪闻任务失落之影途中完成（可查看对应攻略,首次完成可获得精密宝箱）","l":"zh-CN"},{"p":"","o":"纪闻任务失落之影途中完成（可查看对应攻略,首次完成可获得涡轮宝箱）","l":"zh-CN"},{"k":"알맞은 '몸'을 끊임없이 찾는 잔상으로, 유령 인형의 '오른손' 역할을 맡는다."},{"k":"9층 · 알맞은 '몸'을 끊임없이 찾는 잔상으로, 유령 인형의 '오른손' 역할을 맡는다."},{"p":"","o":"在贡多拉站台附近","l":"zh-CN"},{"k":"바다에는 안개가 끼기 시작하고 노랫소리, 풍차 돌아가는 소리, 도시 거리의 떠들썩한 소리가 사방에서 들려온다. 지루한 바다 생활을 더 이상 참지 못한 선원들은 마치 귀신에게 홀린 듯 자옥한 안갯속으로 몰아가는데, 자신들이 잔상의 함정에 빠져들고 있다는 사실을 전혀 인지하지 못한다...\n절경을 향해 나아가는 이야기에서 희망의 빛이 반드시 나타나듯이, 이 위기가 도사린 어두운 바다에도 결국 누군가가 거친 파도를 헤치고 모든 사람에게 희망의 빛을 가져다줄 것이다"},{"k":"알맞은 '몸'을 끊임없이 찾는 잔상으로, 유령 인형의 '왼손' 역할을 맡는다."},{"k":"9층 · 알맞은 '몸'을 끊임없이 찾는 잔상으로, 유령 인형의 '왼손' 역할을 맡는다."},{"p":"9층","o":"传送到乐土右方向的信标，顺着眼前的木楼梯走，然后沿着木道一直走，来到第二张图的位置，声匣在第二张图二层的位置。","l":"zh-CN"},{"p":"","o":"传送到这块区域左上方的信标，然后开着滑翔飞过来，或者沿着道路走过来，在龙骨上面。","l":"zh-CN"},{"p":"","o":"贡多拉站台附近的水面上","l":"zh-CN"},{"p":"","o":"传送到该区域左上方的信标，然后朝着第二张图的位置费，到了这里会看到一个山洞，也就是愚人乐土的一个入口（图3），入口被一堆方块挡住，变熊打碎就能看到。","l":"zh-CN"},{"p":"","o":"传送到该区域左上方的信标，然后一直朝着这里走，或者跳下悬崖开始滑翔，这里还是比较好找的，在一个两层木建筑的中间","l":"zh-CN"},{"p":"","o":"在一个骨头做得建筑物上","l":"zh-CN"},{"p":"","o":"在图二的帐篷里，进去之后右转","l":"zh-CN"},{"p":"","o":"瀑布中间","l":"zh-CN"},{"p":"","o":"信标东方，在一条骨头的下方","l":"zh-CN"},{"p":"","o":"在标记点的下面一个小洞里，洞的的两头是相通的，任意一边跳下去都可以看到。","l":"zh-CN"},{"p":"","o":"这个声匣的位置不是太容易找，先来到和第二张图差不多的位置，然后朝左上方走去，来到第三张图所指的位置，最后走进去。路上有个白猫加速，旁边的废墟里。正面朝着水池往右走到最里面","l":"zh-CN"},{"p":"","o":"这个位置中央龙头的声匣，每个人爬的方法可能都不一样，这边建议先小爬一下旁边那个龙脊，爬到适当位置之后，跳下来，开滑翔，然后冲上来，最后慢慢降落。建议直接把角放出来变个风场起飞","l":"zh-CN"},{"p":"","o":"在下方哦，不用特地去爬那个最高的地方，在悬崖中间","l":"zh-CN"},{"p":"8층","o":"在地下，进入地下入口，左转就可以看到。","l":"zh-CN"},{"p":"","o":"在船体的下面。","l":"zh-CN"},{"p":"","o":"在龙骨之下，屋子的顶上，旁边还有残星会。","l":"zh-CN"},{"p":"","o":"首次完成三个节点目标后可获得三个潮汐之遗奖励（需先完成纪闻任务失落之影后才可开启）","l":"zh-CN"},{"k":"알맞은 '몸'을 끊임없이 찾는 잔상들"},{"k":"별빛 박쥐를 놀라게 하거나 처치하면 얻는다."},{"p":"9층","o":"惊飞或击杀星币伏翼获得。使用大布偶击碎附近石堆j进入洞窟即可看到","l":"zh-CN"},{"k":"9층 · 별빛 박쥐를 놀라게 하거나 처치하면 얻는다."},{"k":"8층 · 별빛 박쥐를 놀라게 하거나 처치하면 얻는다."},{"p":"","o":"因吸收了大量关乎衰败与死亡的频率，最终化为了如骨架般可怖的模样。\n昔日神圣的祭礼地，也因之成为凄苦悲恸的坟茔。救赎之道不在此处，凡进入者，当领受审判的火，接受它的定夺。","l":"zh-CN"},{"k":"9층"},{"k":"그림 2 참고. 색깔 순서대로 화살표가 가리키는 위치를 누르면 된다."},{"p":"","o":"在标点处的山体中，从图2所示位置降落可看到解密地点，如果从东侧飞过来会遇上红名怪并且被山拦住。解法可参考图3，按照颜色顺序点击箭头所指位置即可","l":"zh-CN"},{"p":"","o":"位于悲叹墓岛西南方向地面。解法可参考图2，按照颜色顺序点击箭头所指位置即可","l":"zh-CN"},{"p":"","o":"石阶前与两只幽翎火交战","l":"zh-CN"},{"p":"","o":"石阶上靠近后会从虚空中出现","l":"zh-CN"},{"p":"","o":"在限定时间内躲避琉璃刀伶即可完成挑战 首次完成后可获得基准宝箱","l":"zh-CN"},{"p":"","o":"在限定时间内躲避琉璃刀伶即可完成挑战 首次完成后可获得精密宝箱","l":"zh-CN"},{"p":"","o":"在最高的石头顶部，旁边有一只高天讯使\n坐标 8018，5330，30  当前标点位置有误","l":"zh-CN"},{"p":"","o":"在两块大石头中间，压在三块石头下面\n【坐标：8013，5338，1 】  当前标点位置有误","l":"zh-CN"},{"p":"","o":"在最大和最小的石头中间，面有一块木箱挡着","l":"zh-CN"},{"p":"","o":"位于船上的左侧楼梯下方，可直接开启（标点由玩家silent提供）","l":"zh-CN"},{"p":"","o":"击败周围敌人后解锁","l":"zh-CN"},{"p":"","o":"可直接开启","l":"zh-CN"},{"k":"근처 적을 처치하면 열린다."},{"p":"","o":"【坐标：8379，4460，3】","l":"zh-CN"},{"p":"8층","o":"地下浮光海窟藏宝地，木架上方基准奇藏箱【坐标：8395，4824，187】当前标点位置有误","l":"zh-CN"},{"p":"","o":"完成失落之影任务后出现，可查看对应攻略（标点由玩家万华镜提供）","l":"zh-CN"},{"p":"","o":"完成躲闪挑战后出现—万华镜","l":"zh-CN"},{"p":"","o":"【失落之影】任务中，完成第二次挑战可获得，可查看对应攻略","l":"zh-CN"},{"k":"8층"},{"p":"9층","o":"完成吸收噩梦乌云后与npc对话出现宝箱。（强化螃蟹再最里面）","l":"zh-CN"},{"p":"","o":"【失落之影】任务中，完成第三次挑战可获得，可查看对应攻略","l":"zh-CN"},{"p":"","o":"完成\"三兄弟挑战\"限时飞行出现。图二是接任务的地方","l":"zh-CN"},{"p":"","o":"完成沃德而戈的声骸挑战后获取宝箱（击碎面前的石头），可查看对应攻略获得（标点处为宝箱位置，标点由玩家Seyra提供）","l":"zh-CN"},{"p":"","o":"完成声骸挑战散佚之书收集后获得宝箱，可查看对应攻略获得（标点处为宝箱位置，标点由玩家Seyra提供）","l":"zh-CN"},{"p":"","o":"完成刀伶之舞挑战后获得宝箱，可查看对应攻略获得（标点处为宝箱位置，标点由玩家Seyra提供）有三只哇咔咔守着，清理完之后开启","l":"zh-CN"},{"p":"","o":"在船体残骸中，被一堆木箱挡着(图2红框）。","l":"zh-CN"},{"p":"","o":"在船骸的甲板船头位置（应该是船头把），就是靠近岸边的那个位置,前面有一个木箱挡着。","l":"zh-CN"},{"p":"","o":"在船体废墟旁边，靠近海边的地方。","l":"zh-CN"},{"p":"","o":"在桥下，来这里时候，会看到一堆蓝色方块，靠近之后，不用击碎，直接开奇藏箱","l":"zh-CN"},{"p":"8층","o":"在浮光海窟里，传送到中枢信标的位置，朝着瀑布方向，或者北边的地下入口方向，就能来到地下位置。来到地下位置，顺着束流，来到这个小破船的位置，就可以周到。顺带一提，这次版本的宝箱大多藏在表面，感知特别好用。","l":"zh-CN"},{"p":"8층","o":"在中枢信标那边的洞（向信标左下角走）里是藏宝地其中一个宝箱，在地下，一个斜坡上的拐角那里，旁边有个可破坏的木箱和螃蟹石雕","l":"zh-CN"},{"p":"","o":"这条路上都是残星会。","l":"zh-CN"},{"p":"","o":"来到第二张图的位置，宝箱在这个高帐篷的后面，它后面有个木台，在木台上。","l":"zh-CN"},{"p":"","o":"在小悬崖的木架子上，别跳下去太多，木架子最底下还有一个。","l":"zh-CN"},{"p":"","o":"在悬崖边，可以布偶之跃直接跳上来","l":"zh-CN"},{"p":"9층","o":"传送到愚人乐土右边的地下信标，顺着道路来到与人乐土北边的地下区域，宝箱在柱子的上面。","l":"zh-CN"},{"p":"","o":"在第二张图废墟的二层，宝箱在二层的角落里。","l":"zh-CN"},{"p":"","o":"来到第二张图的位置，宝箱藏在二小姐面前这个帐篷的后面。","l":"zh-CN"},{"p":"","o":"在海边，一个小破船的边上。","l":"zh-CN"},{"p":"","o":"船体废墟中间，外面有两个木箱挡着。","l":"zh-CN"},{"p":"","o":"由三个石块挡着，可以直接跳过去拿（标点由玩家silent提供）","l":"zh-CN"},{"p":"","o":"中间闪光点（图二）过去挖宝箱就会出现，可以拿了就跑（标点由玩家silent提供）","l":"zh-CN"},{"p":"","o":"在标点(闪光处）附近按调查互动获得（标点由玩家silent提供）","l":"zh-CN"},{"p":"","o":"一只巨布偶和两只工头布偶在挖地，中间的闪光点过去互动一下宝箱就出现了，可以不打拿了走（标点由玩家silent提供）","l":"zh-CN"},{"p":"","o":"感知不到，走进去调查才会出现箱子","l":"zh-CN"},{"p":"","o":"涡纹奇藏箱。【失落之影】任务中，完成最后一次骑士试炼可获得","l":"zh-CN"},{"k":"표시 주변을 떠도는 반딧불. 방랑자여, 잡아라!"},{"k":"화려한 의상을 입고 날카로운 칼을 든 인간형 의태 잔상. 전설에서나 존재할 법한 강력한 전투력을 자랑한다"},{"k":"꿈의 노드로 구성된 네트워크에 숨겨져 있는 특수 잔상, 어떤 부정적인 감정이 모여 있는 주파수이다"},{"p":"","o":"完成【巡礼之梦·献给逝者的二重奏】一个节点目标可解锁。需要先完成纪闻任务【失落之影】才可进行挑战，在嗟叹长阶北边的信标附近可以接取任务","l":"zh-CN"},{"p":"","o":"完成【巡礼之梦·墓岛的梦境枢纽】挑战时，枢纽不被摧毁即可解锁。需要先完成纪闻任务【失落之影】才可进行挑战","l":"zh-CN"},{"p":"","o":"完成【巡礼之梦·点燃灵火】一个节点目标可解锁。需要先完成纪闻任务【失落之影】方可开启挑战","l":"zh-CN"},{"p":"","o":"完成【巡礼之梦·魔术使之夜】一个节点目标可解锁。需要先完成纪闻任务【失落之影】方可开启挑战","l":"zh-CN"},{"p":"","o":"完成【巡礼之梦·献给逝者的二重奏】三个节点目标可解锁。需要先完成纪闻任务【失落之影】才可进行挑战，在嗟叹长阶北边的信标附近可以接取任务","l":"zh-CN"},{"p":"","o":"完成【巡礼之梦·墓岛的梦境枢纽】挑战时，枢纽完整度大于60%即可解锁。需要先完成纪闻任务【失落之影】才可进行挑战","l":"zh-CN"},{"p":"","o":"完成【巡礼之梦·点燃灵火】三个节点目标可解锁。需要先完成纪闻任务【失落之影】方可开启挑战","l":"zh-CN"},{"p":"","o":"完成【巡礼之梦·魔术使之夜】三个节点目标可解锁。需要先完成纪闻任务【失落之影】方可开启挑战","l":"zh-CN"},{"p":"","o":"击败红名怪【浮灵魔像】可解锁","l":"zh-CN"},{"p":"","o":"完成【巡礼之梦·魔术使之夜】两个节点目标可解锁。需要先完成纪闻任务【失落之影】方可开启挑战","l":"zh-CN"},{"p":"","o":"完成【巡礼之梦·墓岛的梦境枢纽】挑战时，枢纽完整度大于30%即可解锁。需要先完成纪闻任务【失落之影】才可进行挑战","l":"zh-CN"},{"p":"","o":"完成【巡礼之梦·点燃灵火】两个节点目标可解锁。需要先完成纪闻任务【失落之影】方可开启挑战","l":"zh-CN"},{"p":"","o":"完成【巡礼之梦·献给逝者的二重奏】两个节点目标可解锁。需要先完成纪闻任务【失落之影】才可进行挑战，在嗟叹长阶北边的信标附近可以接取任务","l":"zh-CN"},{"k":"이 보물 지점에는 보물상자가 4곳 있다. 큰 지도나 게임 내 [스캔]로 찾을 수 있다."},{"k":"이 보물 지점에는 보물상자가 5곳 있다. 큰 지도나 게임 내 [스캔]로 찾을 수 있다."},{"p":"8층","o":"该藏宝地共4处宝箱 可通过大地图或游戏内通过【感知】查找（该藏宝地位于浮光海窟地下区域 游戏内可通过追踪该区域隐秘入口进入）","l":"zh-CN"},{"k":"이 보물 지점에는 보물상자가 3곳 있다. 큰 지도나 게임 내 [스캔]로 찾을 수 있다."},{"k":"표시 근처 NPC와 대화하면 챌린지 시작. 처음 완료하면 정밀한 보물상자 획득"},{"p":"9층","o":"在标点附近与NPC对话后开启挑战，首次完成该挑战后可获得精密宝箱（该挑战位于地下区域，可追踪该挑战前往）","l":"zh-CN"}],"markers":[["1321964331816239104",0,17186.0,15372.6,"0",-1],["1321966356134150144",0,17183.3,15373.6,"0",-1],["1321967980193181696",0,17166.2,15357.3,"0",-1],["1321971012033888256",0,17174.3,15326.6,"0",-1],["1321971216866918400",0,17125.5,15297.7,"0",-1