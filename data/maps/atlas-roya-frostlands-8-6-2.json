긴눙가미어","t":{"src":"tiles/layers/8/-1_47/{x}_{y}.webp","tileSize":768,"columns":30,"rows":31,"availableTiles":["12,-26","12,-27","13,-26","13,-27"],"ext":["12,-26","12,-27","13,-26","13,-27"]}}],"descs":[{"k":"46층 · 지하 구역 · 관측소 터널"},{"k":"45층 · 지하 구역 · 관측소 터널"},{"p":"","o":"位于冰原道路沿途的半空中，靠近使用万向锚即可获取","l":"zh-CN"},{"p":"47층","o":"位于渐湖小屋通往雪原道路的半空中","l":"zh-CN"},{"p":"","o":"位于半空","l":"zh-CN"},{"k":"공중에 있음"},{"p":"","o":"位于高空中","l":"zh-CN"},{"k":"44층"},{"p":"","o":"断崖上","l":"zh-CN"},{"p":"44층","o":"该敌人气动伤害抗性提高。\n空间站如流星般坠落，连同那个时代的梦想一同深埋大地。探索者也是怀抱着那梦想中的一员，曾将脚步踏至天外，于星海漫步。如今却已被虚质浸染，栖身黑暗。在最后的力量与理智流逝前，他颤抖着手，将舱体永远封锁。","l":"zh-CN"},{"p":"","o":"日灵周围有木箱子，需要破坏，然后给小日灵拍照。地点请看第三张图和第二张图。","l":"zh-CN"},{"p":"","o":"日灵：山的那边，是什么？","l":"zh-CN"},{"p":"47층","o":"坐下椅子，然后起来和日灵对话","l":"zh-CN"},{"p":"","o":"进入该区域开始虚质磁暴区挑战，完成挑战后可获得奖励（挑战难度高，请一定做好准备！）","l":"zh-CN"},{"p":"","o":"挑战任务【造路悬仪挑战赛道4】","l":"zh-CN"},{"k":"46층"},{"p":"","o":"自上到下依次射击\"3\"\"2\"\"5\"","l":"zh-CN"},{"p":"46층","o":"射击中间","l":"zh-CN"},{"p":"","o":"以第二张图小爱视角来看，旁边一个朴素，左右手近点山崖各有一个基准，左手远点山崖是一个基准，右手远点山崖是一个朴素；使用鹰眼无人机一键开宝箱就好。","l":"zh-CN"},{"p":"","o":"此处宝箱分布如第二张图所示，左边两个、右边三个，先来到右边，之后来看第三张图的位置，小爱右手边有一个基准，左手边远点的山崖上，有一个基准，正面面对的山崖上，有一个朴素；开鹰眼一键扫描就好，没必要一个个拿。","l":"zh-CN"},{"p":"","o":"此处宝箱分布如第二张图所示，左边两个、右边三个，接下来去到左边，来看第三张图的位置，小爱面前有个朴素，右手边山崖上有一个基准。；开鹰眼一键扫描就好，没必要一个个拿。","l":"zh-CN"},{"p":"","o":"任务“冲破寒冰之境”，从第三张图信标位置冲下来，这里有个小机器人，对话，会进入一段赛车，之后给三个基准。","l":"zh-CN"},{"p":"","o":"任务“冲破寒冰之境”，从第三张图信标位置冲下来，这里有个小机器人，对话，会进入一段赛车，之后给两个基准一个朴素。","l":"zh-CN"},{"p":"","o":"推进任务“冲破寒冰之境”，第二次赛车的宝箱，两基准一朴素；接取任务请看第三张图和第二张图。","l":"zh-CN"},{"p":"46층","o":"以第二张图小爱位置来看，左手边三个宝箱，右手边两个；先看左手边，山崖近点有一个基准，屋子旁边的冰台上有一个朴素，屋子的高处有一个基准；再看右手边，屋子左方的集装箱上有一个基准，右侧最高的山崖上，有一个朴素；用鹰眼无人机一键开启就好。","l":"zh-CN"},{"k":"바이크 챌린지 상자. 챌린지 장소는 두 번째 그림의 네모 표시 위치 참고."},{"k":"46층 · 「태양의 정령을 이끄는 자」 챌린지 상자."},{"p":"","o":"此处需要使用显像功能，显像格洛犸图声骸。","l":"zh-CN"},{"p":"","o":"可以传送到打牌威尔艾米娜再来这里，先清怪再使用显像功能，显像格洛犸图声骸。\n该宝箱品质并非固定，根据冰洞次数来决定。全图共4个冰洞。\n冰洞第一次为【基准】、第二次【精密】、第三次【涡纹】、第四次【日灵】（之后前往罗伊冰原·地表，日灵归还处上方，与日灵对话，获得成就【日灵三窟】）","l":"zh-CN"},{"p":"46층","o":"先传送到这个标点旁边的地下信标，之后会有一个任务指引，一个胆怯的日灵，和它对话，对话之后跟着任务坐到崖边，日灵会把你推下去，卑鄙的日灵，之后清怪就可以。","l":"zh-CN"},{"p":"","o":"摩托挑战宝箱，挑战地点就在标点位置，失败五次强制结算。来到地图最高点往下看红圈位置","l":"zh-CN"},{"p":"46층","o":"使用显像功能，显像格洛犸图声骸。 该宝箱品质并非固定，根据冰洞次数来决定。全图共4个冰洞。 冰洞第一次为【基准】、第二次【精密】、第三次【涡纹】、第四次【日灵】（之后前往罗伊冰原·地表，日灵归还处上方，与日灵对话，获得成就【日灵三窟】）（感谢玩家反馈。）","l":"zh-CN"},{"p":"","o":"摩托挑战宝箱，如果觉得小难得，就直接失败五次，然后可以直接领取。","l":"zh-CN"},{"p":"","o":"需要从第二张图小爱面前的山洞走进去，具体走法请看第三张图。","l":"zh-CN"},{"p":"45층","o":"\"永冻遗航\"分层入口","l":"zh-CN"},{"p":"44층","o":"“封锁舱段·天槎空间站”分层入口","l":"zh-CN"},{"k":"보이드 스톰 구역 챌린지 상자."},{"k":"적을 처치해야 한다."},{"k":"44층 · 적을 처치해야 한다."},{"k":"47층"},{"p":"","o":"冰晶道路，穿过冰柱门后，三只分别在路两侧","l":"zh-CN"},{"p":"","o":"两只一起与罗伊流民交战","l":"zh-CN"},{"p":"","o":"半山腰冰晶道路西侧两只一起","l":"zh-CN"},{"p":"","o":"三个和冠顶械隼一起守着潮汐之遗","l":"zh-CN"}],"markers":[["1467472260452962304",0,9051.0,3966.5,"-1/46",0],["1467472413633331200",0,9055.7,3970.9,"-1/46",0],["1467472463125925888",0,9055.9,3971.4,"-1/46",0],["1467472512455135232",0,9058.3,3971.6,"-1/45",1],["1467473542660083712",0,9058.9,3971.7,"-1/46",0],["1466938166182793216",1,9378.0,3800.5,"0",-1],["1466938205076766720",1,9375.9,3800.2,"0",-1],["1466938241164558336",1,9375.9,3803.6,"0",-1],["1466938272143495168",1,9374.0,3802.9,"0",-1],["1466938325319073792",1,9378.3,3805.1,"0",-1],["1466938372592881664",1,9374.6,3805.7,"0",-1],["1466938419401506816",1,9378.2,3802.2,"0",-1],["1466938447838887936",1,9383.7,3798.8,"0",-1],["1466938502616498176",1,9385.6,3800.1,"0",-1],["1466938533683515392",1,9385.7,3797.1,"0",-1],["1466938577929420800",1,9387.0,3797.3,"0",-1],["1466938609193570304",1,9387.9,3798.8,"0",-1],["1490521032657666048",2,9980.9,4505.3,"0",-1],["1469332779799724032",3,9001.0,4332.4,"0",2],["1469365351220891648",3,9769.9,3532.8,"-1/47",3],["1469379040561119232",3,9300.9,3887.9,"0",4],["1469411825023762432",3,8976.6,3999.0,"0",5],["1469412887843618816",3,9056.1,4110.2,"0",6],["1490502284508856320",4,9881.0,4526.2,"0",-1],["1490509855415095296",4,9842.4,38