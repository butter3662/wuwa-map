id":"SP_IconMonsterHead_32032_UI","n":"소용돌이 곰","g":"enemies","c":"#b8a1ff","i":"tiles/icons/f242311f0bd14f2a3853.webp"},{"id":"cbd","n":"보물 지점","g":"exploration","c":"#f07e83","i":"tiles/icons/5111afe1ca71aba1d1e3.webp"},{"id":"CS_02","n":"소형 비콘","g":"exploration","c":"#6cc8ee","i":"tiles/icons/ace53ba2750c41850ccd.webp"},{"id":"SP_IconMonsterHead_31044_UI","n":"구름 바다 요정","g":"enemies","c":"#9fdb72","i":"tiles/icons/9e511c8d358166759ece.webp"},{"id":"CS_01","n":"중추 비콘","g":"exploration","c":"#8bd3c7","i":"tiles/icons/35bb0bb1bbd2f285b3bf.webp"},{"id":"sxdtz","n":"삼형제 도전","g":"exploration","c":"#f8c963","i":"tiles/icons/126c86cc5d390706ea29.webp"}],"def":["qzx_02","qzx_03","qzx_01","qzx_04"],"layers":[{"id":"-1/11","n":"암석의 흔적","gid":"11","gn":"암석의 흔적","t":{"src":"tiles/layers/8/-1_11/{x}_{y}.webp","tileSize":768,"columns":30,"rows":31,"availableTiles":["22,-11"],"ext":["22,-11"]}}],"descs":[{"p":"","o":"两株挨在一起","l":"zh-CN"},{"p":"","o":"位于洞穴中，从北侧洞口进入","l":"zh-CN"},{"p":"","o":"两棵树下一个","l":"zh-CN"},{"k":"덤불 앞 1개"},{"p":"","o":"花圃里一个","l":"zh-CN"},{"p":"","o":"山脚下三个","l":"zh-CN"},{"k":"산 아래 풀밭에 총 4개"},{"p":"","o":"山下草地上两个","l":"zh-CN"},{"k":"절벽 가장자리"},{"p":"","o":"草丛旁边","l":"zh-CN"},{"p":"","o":"岩石旁","l":"zh-CN"},{"k":"알맞은 '몸'을 끊임없이 찾는 잔상으로, 유령 인형의 '오른손' 역할을 맡는다."},{"k":"알맞은 '몸'을 끊임없이 찾는 잔상으로, 유령 인형의 '왼손' 역할을 맡는다."},{"p":"","o":"传送到隐海修会右边的信标，直接就可以看到。","l":"zh-CN"},{"p":"","o":"独眼风车群右上方的最高屋顶上。","l":"zh-CN"},{"p":"","o":"在这个坐标的桥下","l":"zh-CN"},{"p":"","o":"主线任务路过时不显示，可以做完再回来拿，就在大门口","l":"zh-CN"},{"p":"","o":"在石洞门口，坐标位置的下面","l":"zh-CN"},{"p":"","o":"在车站内部的顶上","l":"zh-CN"},{"p":"","o":"传送到一旁的信标，转过来抬起头就可以看到。","l":"zh-CN"},{"p":"","o":"在传送点南方的建筑顶端（要先击败这里的懒惰骑士，否则不会出现这个声匣）（注：也有直接获取无需作战的情况存在，避开懒惰骑士是可行的）","l":"zh-CN"},{"p":"","o":"传送到一旁的信标之后，朝着下方看，这个声匣在信标的山崖和对面山崖的中间，可以先调到废墟上。图二可以作为参考","l":"zh-CN"},{"p":"11층","o":"首次完成三个节点目标后可获得三个潮汐之遗奖励（该标点位于地下区域，游戏内可追踪隐秘入口进入）","l":"zh-CN"},{"k":"처음으로 노드 목표 3개를 완료하면 조석의 유산 3개 획득"},{"p":"","o":"不断寻找着合适「身躯」的残象们。","l":"zh-CN"},{"p":"","o":"惊飞或击杀星币伏翼获得。旁边有声匣，第一次获取声匣的时候直接给它吓飞","l":"zh-CN"},{"p":"11층","o":"惊飞或击杀星币伏翼获得。在洞窟入口处","l":"zh-CN"},{"p":"11층","o":"惊飞或击杀星币伏翼获得。在洞窟顶部","l":"zh-CN"},{"k":"11층 · 별빛 박쥐를 놀라게 하거나 처치하면 얻는다."},{"p":"11층","o":"惊飞或击杀星币伏翼获得。洞窟内树上","l":"zh-CN"},{"k":"별빛 박쥐를 놀라게 하거나 처치하면 얻는다."},{"p":"","o":"惊飞或击杀星币伏翼获得。建筑内天花板上","l":"zh-CN"},{"p":"","o":"惊飞或击杀正在卧沙的星币伏翼获得。","l":"zh-CN"},{"k":"얼어붙은 지역을 휩쓸고 다니는 늑대형 의태 생물로, 냉혈적이고 무자비한 성질로 악명이 높다"},{"k":"절벽 가장자리 1개"},{"p":"","o":"小山坡下","l":"zh-CN"},{"k":"길가에 1개"},{"k":"나무 아래 1개"},{"p":"","o":"大石头边两个","l":"zh-CN"},{"p":"","o":"草地上一个（不小心摘了）","l":"zh-CN"},{"p":"","o":"路口碎石堆一个","l":"zh-CN"},{"p":"","o":"大石块前一个","l":"zh-CN"},{"p":"","o":"路边木桶后一个","l":"zh-CN"},{"p":"","o":"路边石块前","l":"zh-CN"},{"k":"꿈의 노드로 구성된 네트워크에 숨겨져 있는 특수 잔상, 어떤 부정적인 감정이 모여 있는 주파수이다"},{"k":"고지대를 지배하는 늑대형 의태 생물로, 집요한 사냥 방식과 끈질긴 추적 능력으로 악명이 높다"},{"k":"그림 2 참고. 색깔 순서대로 화살표가 가리키는 위치를 누르면 된다."},{"p":"","o":"石廊下方阶梯上两个并排","l":"zh-CN"},{"p":"","o":"石廊下方阶梯上，两个并排","l":"zh-CN"},{"p":"","o":"遗迹门口站立","l":"zh-CN"},{"k":"종 속에 사는 푸른 게. 땡땡게는 뒤집히거나 썩은 난파선 아래에 숨어 포식자의 눈을 피한다."},{"k":"인형에 기생하는 실체 없는 잔상. 성실하고 근면하게 일하는 인형의 모습을 흉내 낸다"},{"k":"인형에 기생하는 실체 없는 잔상. 매력적이며 유머러스한 인형의 모습을 모사한다"},{"p":"","o":"在限定时间内躲避琉璃刀伶即可完成挑战 首次完成后可获得基准宝箱","l":"zh-CN"},{"p":"","o":"可直接开启","l":"zh-CN"},{"p":"","o":"可直接开启，位于建筑门口上层平台处","l":"zh-CN"},{"p":"","o":"击败敌人后开启（标点由玩家星玖onlive提供）","l":"zh-CN"},{"p":"","o":"完成标点附近全息战略·刀怜之舞解锁，与中间的柱子互动开启挑战（标点由玩家雲开提供）","l":"zh-CN"},{"p":"","o":"收集五把骑士剑后将剑插在拜月林迹湖四周后，击败湖中的骑士后获得，可查看对应攻略获得（标点处为宝箱位置，标点由玩家Seyra提供）","l":"zh-CN"},{"p":"","o":"在标点附近完成全息战略-刀伶之舞后出现宝箱（标点由索拉里斯最强共鸣者—卡卡罗ID的玩家提供）安全位置：拐角处无痛过","l":"zh-CN"},{"p":"","o":"击败宝箱周围怪物后解锁","l":"zh-CN"},{"p":"","o":"击败周围怪物后解锁","l":"zh-CN"},{"p":"","o":"在高塔后方，击败周围怪物后解锁（两只浮灵偶、一只浮灵偶·莱特、一只浮灵偶·蕾弗）（标点由玩家星玖onlive提供）","l":"zh-CN"},{"p":"","o":"在标点附近与图中沃德尔戈对话，完成声骸挑战·怪力布偶拳后出现宝箱（标点由玩家雲开提供）","l":"zh-CN"},{"p":"","o":"先与图三位置处的NPC沃德尔戈（图二）对话，完成限时挑战后出现宝箱，标点处为宝箱位置（图一）（标点由玩家雲开提供）","l":"zh-CN"},{"p":"","o":"先将标点附近3个石碑拉到基座上（如图2），再变身，长按小技能吸收噩梦乌云，吸收完后来到宝箱处和沃德戈对话后出现宝箱（标点由玩家雲开提供）","l":"zh-CN"},{"p":"","o":"完成此处声骸挑战散佚之书收集后获取。（标点由玩家雲开提供）","l":"zh-CN"},{"p":"","o":"这处房子周围的怪比较多，建议先都清干净再开全部的宝箱，也可以直接过去开了然后跑，朴素宝箱再上了中央台阶右转的小塔顶上面。","l":"zh-CN"},{"p":"","o":"传送到一旁的挑战位置，或者传送到独揽风车群的上方信标；如果传送到挑战那里，则朝着西北方向走一点，找到一颗大树；如果传送到信标，则朝着西边滑翔，但注意不要到河边去，也是来这里找大树的位置。","l":"zh-CN"},{"p":"","o":"独揽风车群下方的信标，传送来之后，信标的北方向就可以看到。在最高塔的西北方的一个小矮塔顶  做主线时没有 主线做完再来","l":"zh-CN"},{"p":"","o":"在倒塌的石柱中间。","l":"zh-CN"},{"p":"","o":"传送到独眼风车群的下方信标，然后朝着水潭这边一直走，来到瀑布下方，就能看到。","l":"zh-CN"},{"p":"","o":"位置很好找，来到这里之后，来到第二张图片的位置，进入石门，然后右转，就能看到宝箱，左转是一个欺诈宝箱","l":"zh-CN"},{"p":"","o":"传送到白雾堤上方的信标，朝着标点位置走，就能找到。第一次来这里需要击败四个残星会成员，然后接触第一个宝箱之后，会有出现隐藏任务的【贪婪骑士】，击杀之后会获得贪婪骑士剑，之后就可以正常开宝箱了。","l":"zh-CN"},{"p":"","o":"这个应该不用多说，地方好找，宝箱也不隐秘。","l":"zh-CN"},{"p":"","o":"位于建筑顶部下方小平台处，可直接开启","l":"zh-CN"},{"p":"","o":"可直接开启，位于塔楼顶部（标点由玩家星玖onlive提供）","l":"zh-CN"},{"p":"","o":"在老船长达维德处完成支线任务天际奇旅后的奖励宝箱，可查看对应攻略获得（标点由玩家Seyra提供）","l":"zh-CN"},{"k":"표시 주변을 떠도는 반딧불. 방랑자여, 잡아라!"},{"p":"","o":"隐藏任务 需结合相关攻略辅助完成（该点位需先击败怪物开启宝箱后出现 最终击败后完成该点位任务）\n在风车下的小屋附近活动的神秘骑士，计划将世间的一切财宝装进它的宝箱中。","l":"zh-CN"},{"p":"","o":"隐藏任务 需结合相关攻略辅助完成\n迷失在白月林迹的特殊骑士，似乎想出了答案，却忘了问题是什么……","l":"zh-CN"},{"p":"","o":"隐藏任务 需结合相关攻略辅助完成\n作乱于白雾堤以西的残暴骑士，大家只知它对敌人无情，可它的盟友的究竟是谁？","l":"zh-CN"},{"k":"인형에 기생하는 실체 없는 잔상. 말수가 적고 상대의 말을 잘 들어주는 인형의 모습을 흉내 낸다"},{"k":"11층"},{"p":"","o":"完成【巡礼之梦·水畔的梦境枢纽】挑战时，梦境枢纽不被摧毁即可解锁","l":"zh-CN"},{"p":"","o":"完成【巡礼之梦·遗愿的骑士】一个节点目标可解锁","l":"zh-CN"},{"p":"11층","o":"传送点东北方向山崖下进入洞窟，完成【巡礼之梦·风车之主】一个节点目标可解锁","l":"zh-CN"},{"p":"","o":"完成【巡礼之梦·职业保安】一个节点目标可解锁","l":"zh-CN"},{"p":"","o":"完成【巡礼之梦·水畔的梦境枢纽】挑战时，梦境枢纽完整度大于60%即可解锁","l":"zh-CN"},{"p":"11층","o":"传送点东北方向山崖下进入洞窟，完成【巡礼之梦·风车之主】的三个节点目标可解锁","l":"zh-CN"},{"p":"","o":"完成【巡礼之梦·遗愿的骑士】三个节点目标可解锁","l":"zh-CN"},{"p":"","o":"完成【巡礼之梦·职业保安】三个节点目标可解锁","l":"zh-CN"},{"p":"","o":"完成【巡礼之梦·遗愿的骑士】两个节点目标可解锁","l":"zh-CN"},{"p":"11층","o":"传送点东北方向山崖下进入洞窟，完成【巡礼之梦·风车之主】两个节点目标可解锁","l":"zh-CN"},{"p":"","o":"完成【巡礼之梦·职业保安】两个节点目标可解锁","l":"zh-CN"},{"p":"","o":"完成【巡礼之梦·水畔的梦境枢纽】挑战时，梦境枢纽完整度大于30%即可解锁","l":"zh-CN"},{"k":"이 보물 지점에는 보물상자가 4곳 있다. 큰 지도나 게임