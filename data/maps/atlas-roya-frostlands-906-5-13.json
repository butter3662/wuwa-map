 있으며, 해당 부위를 성공적으로 파괴하면 아이언후프의 공격력과 공격 범위를 감소시킬 수 있습니다"},{"k":"스페이스트렉 콜렉티브가 개발한 탐측용 로봇. 아담하고 민첩하여 라하이 로이의 복잡한 지형에 알맞다"},{"p":"","o":"此点位为日灵实际站位，使用显像声骸岩蛛之后，会出来一个日灵，和此处原本躺着的日灵站在一起。（此处一共两个日灵，因此存在两个点位。）","l":"zh-CN"}],"markers":[["1453139342074785792",0,5353.6,5938.6,"0",0],["1458601434672156672",1,5354.2,5937.2,"0",1],["1526360029421486080",1,4590.0,6188.9,"0",-1],["1454512882371997696",2,5044.4,5994.9,"0",-1],["1454512882527186944",2,5045.3,5992.2,"0",-1],["1454512882682376192",2,5047.1,5992.2,"0",-1],["1454512882837565440",2,5046.2,5994.0,"0",-1],["1454512882992754688",2,5048.0,5994.0,"0",-1],["1454512883143749632",2,5046.2,5994.9,"0",-1],["1454512883298938880",2,5046.2,5995.8,"0",-1],["1454512883449933824",2,5045.3,5996.7,"0",-1],["1454515826226163712",2,5037.2,5993.1,"0",-1],["1454515826322632704",2,5038.1,5994.0,"0",-1],["1454515826410713088",2,5039.0,5994.9,"0",-1],["1454515826507182080",2,5037.2,5995.8,"0",-1],["1454515826599456768",2,5039.0,5997.6,"0",-1],["1454516346391162880",2,4999.2,6041.0,"0",-1],["1454516346491826176",2,5000.1,6040.1,"0",-1],["1454517275580493824",2,5003.7,6034.7,"0",-1],["1454517275693740032",2,5001.9,6032.0,"0",-1],["1454517275790209024",2,5000.1,6032.9,"0",-1],["1454517275890872320",2,5000.1,6033.8,"0",-1],["1454517275987341312",2,4999.2,6035.6,"0",-1],["1454517276083810304",2,5001.0,6036.5,"0",-1],["1454520592507400192",2,4806.8,6053.6,"0",-1],["1454520779172687872",2,4807.7,6050.9,"0",-1],["1454522564201361408",2,4808.6,6047.3,"0",-1],["1454522564360744960",2,4808.6,6046.4,"0",-1],["1454522564520128512",2,4806.8,6046.4,"0",-1],["1454522564675317760",2,4806.8,6045.5,"0",-1],["1454522564838895616",2,4805.0,6045.5,"0",-1],["1454522564998279168",2,4805.0,6047.3,"0",-1],["1454522565157662720",2,4803.2,6045.5,"0",-1],["1454522565317046272",2,4809.5,6045.5,"0",-1],["1454522565476429824",2,4808.6,6044.6,"0",-1],["1454522565635813376",2,4808.6,6043.7,"0",-1],["1454522565795196928",2,4808.6,6042.8,"0",-1],["1454522565954580480",2,4807.7,6043.7