":"#f8c963","i":"tiles/icons/0c7a54e50bc0c14d21d1.webp"},{"id":"T_IconC_054_UI","n":"「다음 생」","g":"resources","c":"#b8a1ff","i":"tiles/icons/0bd95f44d16dd34235cb.webp"},{"id":"SP_IconMonsterHead_972_UI","n":"잔성 · 사이보그 해머링맨","g":"enemies","c":"#f07e83","i":"tiles/icons/ef677d40ae72238c9232.webp"},{"id":"SP_IconMonsterHead_31049_UI","n":"금석 암괴","g":"enemies","c":"#6cc8ee","i":"tiles/icons/8d83d7bee1fe18647853.webp"},{"id":"SP_IconMonsterHead_31050_UI","n":"유약 암괴","g":"enemies","c":"#9fdb72","i":"tiles/icons/8bb75f60142ef948be69.webp"},{"id":"SP_IconMonsterHead_31056_UI","n":"드레이크 · 전도","g":"enemies","c":"#8bd3c7","i":"tiles/icons/9bbaa5b7cb0b6286878c.webp"},{"id":"SP_IconMonsterHead_31052_UI","n":"라 과디어","g":"enemies","c":"#f8c963","i":"tiles/icons/a8417e504aaea1dfd5db.webp"},{"id":"320000430","n":"악몽 · 초혼의 악사","g":"enemies","c":"#b8a1ff","i":"tiles/icons/70eb172e561d25006f00.webp"},{"id":"SP_IconMonsterHead_32032_UI","n":"소용돌이 곰","g":"enemies","c":"#f07e83","i":"tiles/icons/f242311f0bd14f2a3853.webp"},{"id":"310000630","n":"악몽 · 심판하는 전사","g":"enemies","c":"#6cc8ee","i":"tiles/icons/7521531792c84ee502de.webp"}],"def":["qzx_01","qzx_02","qzx_03","qzx_04"],"layers":[{"id":"-1/22","n":"에너지 저장 중추 아래층","gid":"22","gn":"에너지 저장 중추 아래층","t":{"src":"tiles/layers/905/-1_22/{x}_{y}.webp","tileSize":768,"columns":13,"rows":11,"availableTiles":["6,-7","6,-8","7,-7","7,-8"],"ext":["6,-7","6,-8","7,-7","7,-8"]}}],"areas":[{"n":"수많은 죽음이 잠든 섬","b":{"minX":7965.515,"minY":3330.409,"maxX":9099.445,"maxY":4269.176}},{"n":"생명의 땅","b":{"minX":6476.326999999999,"minY":4671.825,"maxX":7585.599,"maxY":5726.976000000001}},{"n":"에너지 저장 중추","b":{"minX":4656.790999999999,"minY":2804.555,"maxX":5808.791,"maxY":4193.678}},{"n":"순례의 땅","b":{"minX":2864.188,"minY":3339.445,"maxX":3699.953,"maxY":4018.6549999999997}},{"n":"빛을 뿜어내는 탑","b":{"minX":1705.864,"minY":5460.027999999999,"maxX":2959.854,"maxY":7634.046}}],"descs":[{"k":"탄식 무덤의 섬을 배회하는 기괴한 조류형 잔상으로, 어둠 속에서는 몸이 그림자에 녹아들어 불타는 가면만이 도깨비불처럼 어렴풋이 떠오른다"},{"k":"필멸자는 모두 운명의 죄수이며, 이 세상의 모든 것은 허망한 환영일 뿐이다. 달의 모습이 바뀌어도 오직 죽음과 소멸만은 영원히 변하지 않는다.\n피안화로 엮은 무대 위에서, 그녀는 플로로의 지휘와 함께 「완벽한」 교향곡을 써 내려갈 것이다."},{"p":"","o":"点击地图，乐曲调律可以直接追踪。这是主线中的调律装置。","l":"zh-CN"},{"p":"","o":"点击地图，乐曲调律可以直接追踪，此为主线已完成调律装置。（图二是解法）","l":"zh-CN"},{"p":"","o":"点击地图，乐曲调律可以直接追踪，第二张图是解密方法。","l":"zh-CN"},{"p":"","o":"点击地图，乐曲调律可以直接追踪，此为主线已解锁调律装置。","l":"zh-CN"},{"p":"22층","o":"该敌人衍射伤害抗性提高。\n配有弓矢的塑像，在监视拉古那城的同时也肩负着与修会联络的职责。","l":"zh-CN"},{"p":"22층","o":"该敌人衍射伤害抗性提高。\n配有弓矢的塑像，在监视拉古那城的同时也肩负着与修会联络的职责。\n一旦发现可疑人员或是声骸，会立刻对其进行抓捕并带入诫令院进行审判，以确保城内的安宁不被打扰破坏。","l":"zh-CN"},{"k":"22층 · 꼭 주의! 먼저 그림 2 위치로 가서 그림 3 오른쪽 큰 문과 상호작용해 이 구역으로 이동해야 갈 수 있다. 이 적은 회절 피해 저항이 높다.\n활과 화살을 든 조각상으로, 라군나 성을 감시하는 동시에 수도회와의 연락도 맡는다.\n의심스러운 사람이나 에코를 발견하면 즉시 체포해 계령원으로 데려가 심판함으로써 성 안의 평온이 깨지지 않도록 한다."},{"k":"22층 · 꼭 주의! 먼저 그림 2 위치로 가서 그림 3 오른쪽 큰 문과 상호작용해 이 구역으로 이동해야 갈 수 있다. 이 적은 회절 피해 저항이 높다. 활과 화살을 든 조각상으로, 라군나 성을 감시하는 동시에 수도회와의 연락도 맡는다. 의심스러운 사람이나 에코를 발견하면 즉시 체포해 계령원으로 데려가 심판함으로써 성 안의 평온이 깨지지 않도록 한다."},{"k":"22층 · 꼭 주의! 먼저 그림 2 위치로 가서 그림 3 오른쪽 큰 문과 상호작용해 이 구역으로 이동해야 갈 수 있다. 표시된 구역은 복도 왼쪽에서 로프로 들어가야 한다. 이 적은 회절 피해 저항이 높다. 활과 화살을 든 조각상으로, 라군나 성을 감시하는 동시에 수도회와의 연락도 맡는다."},{"k":"수많은 죽음이 잠든 섬 오른쪽 비콘으로 이동한다. 옆 벽은 오를 수 없으니 눈앞의 길을 따라 쭉 가면, 즉 두 번째 그림에서 플로로가 정면으로 바라보는 방향으로 계속 가면 찾는다. 스토리를 진행할 때 이곳을 지나간다."},{"p":"","o":"这个宝箱，在主线任务的必经道路上，在一个斜坡拐角上方。总之，传送到千殁沉岛左方向的信标，然后沿着道路走，肯定能找到。","l":"zh-CN"},{"k":"비콘으로 이동하면 바로 보인다. 메인 스토리 보물상자"},{"k":"메인 스토리에서 운송 레일을 타고 내려오면 보물상자는 왼쪽"},{"k":"모퉁이 바깥 절벽 가장자리"},{"k":"소형 비콘으로 이동하면 바로 보물상자가 보인다. 비콘 위쪽(북쪽) 돌기둥 옆."},{"k":"플로로가 준 피안화의 시간 감속을 이용해 회전판과 전기 구슬을 통과한다. 바로 날아와서 타이밍을 맞춰 열어도 된다."},{"p":"22층","o":"蓄能中枢地下地图的宝箱，我强烈建议各位在剧情时候就直接拿了，传送点见图二，从步骤2图片中左侧路口进入。（感谢玩家“三顾喵房”提供图片。）","l":"zh-CN"},{"p":"22층","o":"蓄能中枢地下地图的宝箱，我强烈建议各位在剧情时候就直接拿了，单独操作主角的时，在帮助弗洛洛通过长廊的时候可遇见。传送点见图二。（感谢玩家“三顾喵房”提供图片。）","l":"zh-CN"},{"p":"22층","o":"蓄能中枢地下地图的宝箱，我强烈建议各位在剧情时候就直接拿了，传送点见图二。（感谢玩家“三顾喵房”提供图片。）","l":"zh-CN"},{"k":"표시 위치에서 근처 장치와 상호작용해 참배를 마치면 보물상자가 나타난다. 장치는 그림 2에서 카르티시아 앞의 받침대다 (표시는 플레이어 kirsly 제공)"},{"k":"스토리를 여기까지 진행하면 보인다. 수많은 죽음이 잠든 섬 오른쪽 비콘으로 이동하면 바로 보인다."},{"k":"표시에 지하 표시가 있다면 내가 위치를 직접 조정했기 때문이다. 스토리를 진행할 때 이 보물상자를 지나간다. 소형 비콘으로 이동한 뒤 소형 비콘 오른쪽 아래(남동쪽)에 있다."},{"p":"","o":"这个宝箱走过来的时候，肯定会看到一个传电装置，启动它，并且使用彼岸花，否则这个宝箱的大门是封住的。","l":"zh-CN"},{"p":"22층","o":"蓄能中枢地下地图的宝箱，我强烈建议各位在剧情时候就直接拿了，剧情中单独操作弗洛洛的时候，经过类似通风管的通道之后，在出通风管的房间。传送点见图二。（感谢玩家“三顾喵房”提供图片。）","l":"zh-CN"},{"k":"메인 임무 도중 얻는다 (표시는 플레이어 kirsly 제공)"},{"k":"지도에서 슬롯머신을 바로 추적할 수 있다. 메인 스토리에서 플로로가 준 피안화로 퍼즐을 풀 수 있다."},{"p":"","o":"点击地图，圣箱寻物可以直接追踪，同时，使用主线中弗洛洛给的彼岸花可以解密。","l":"zh-CN"},{"k":"폐수 한가운데. 바로 날아와서 플로로가 준 피안화로 시간을 늦추고 동시에 나타나는 무늬 3개를 공격한다"},{"p":"","o":"点击地图，圣箱寻物可以直接追踪，同时，使用主线中弗洛洛给的彼岸花可以解密。这三个雷电球，在解密之后就会消失，三个控能装置也要用弗洛洛的彼岸花去控制。","l":"zh-CN"},{"p":"","o":"点击地图，圣箱寻物可以直接追踪，同时，使用主线中弗洛洛给的彼岸花可以解密。旁边的NPC【「服事人」巴德勒】可以兑换物资，星声和周本材料之类的。","l":"zh-CN"},{"p":"","o":"点击地图，圣箱寻物可以直接追踪，同时，使用主线中弗洛洛给的彼岸花可以解密。这个位置的箱子，需要传送一下电力才能开门，用彼岸花就很方便。","l":"zh-CN"},{"k":"22층 · 메인 스토리에서 주인공을 혼자 조작할 때 만난다. 플로로가 준 피안화로 시간을 멈춘 뒤 똑같은 공격 3개를 보면 된다 (표시는 플레이어 윈카이 제공)"},{"k":"22층 · 메인 스토리에서 주인공을 혼자 조작할 때 만난다. 플로로가 준 피안화로 시간을 느리게 한 뒤 같은 무늬 3개를 공격하면 열린다 (표시는 플레이어 윈카이 제공)"},{"p":"","o":"路线图请看第二张图，画圈位置是个小分岔路，千万别走歪了。","l":"zh-CN"},{"k":"어린 드레이크 형태의 잔상, 발톱 사이엔 빠른 기류가 돌고 있으며 군집의 형식으로 야외에서 활약한다"},{"k":"완벽에 이르지 못한 피안은 잠시 세상에 사라졌지만, 깨진 거울은 여전히 바닷물 아래서 과거의 고집과 희망을 비추고 있다. 언제 들어가든 다시 태어난 기쁨의 웃음소리가 귓가에 맴돌며 환생의 언덕으로 나아갈 수 있는 변치 않는 영원을 나타낸다"},{"p":"22층","o":"蓄能中枢下层入口","l":"zh-CN"},{"k":"스토리를 여기까지 진행하면 나타난다"},{"k":"깊은 바다 실험장 · 순례의 땅"},{"k":"해당 적은 회절 피해 저항이 증가한다.\n해체와 재건을 상징하는 석조 형상의 잔상, 움직임은 둔하고 느리지만, 주먹의 힘은 놀라울 정도로 강하다.\n먼 거리에서 암석과 괴암을 투척할 수 있는데, 하나의 공격 수단으로 사용되고 있다"},{"p":"22층","o":"该敌人衍射伤害抗性提高。\n拥有指挥调度其他节使的权限，遵从修会的指令对所有忤逆者进行清除。\n权威不可侵犯，修会不容质疑。","l":"zh-CN"},{"k":"22층 · 꼭 주의! 먼저 그림 2 위치로 가서 그림 3 오른쪽 큰 문과 상호작용해 이 구역으로 이동해야 갈 수 있다. 이 적은 회절 피해 저항이 높다.\n다른 사절을 지휘할 권한이 있으며, 수도회의 명령에 따라 거역하는 자를 모두 제거한다.\n권위는 침범할 수 없고, 수도회는 의심받지 않는다."},{"k":"22층 · 꼭 주의! 먼저 그림 2 위치로 가서 그림 3 오른쪽 큰 문과 상호작용해 이 구역으로 이동해야 갈 수 있다. 표시된 구역은 복도 왼쪽에서 로프로 들어가야 한다. 이 적은 회절 피해 저항이 높다. 다른 사절을 지휘할 권한이 있으며, 수도회의 명령에 따라 거역하는 자를 모두 제거한다. 권위는 침범할 수 없고, 수도회는 의심받지 않는다."},{"k":"해당 지역은 매일 일정 수의 악몽 잔상이 갱신되며, 악몽 잔상을 격파한 후에는 특정 악몽 에코를 획득할 수 있다"},{"k":"지도에서 바로 추적할 수 있다. 장치를 작동한 뒤 왼쪽부터 오른쪽으로 돌판을 순서대로 밟는다. 빠르면 그냥 밟으면 되고, 느리면 플로로가 준 피안화로 시간을 늦춰 조작하면 된다. 완료하면 정밀한 보물상자를 얻는다."},{"k":"지도에서 에너지 수송관 연결 도전을 추적할 수 있으며 완료하면 평범한 보물상자가 나온다. 위쪽에 있어 비콘에서 달려온 뒤 올라가야 보인다. 장치를 작동하고 앞의 돌판을 밟으면 된다"},{"k":"큰 지도에서 에너지 수송관 연결 도전을 추적할 수 있으며 완료하면 정밀한 보물상자가 나온다. (먼저 스위치를 켜고 플로로가 준 피안화 능력으로 시간을 늦춘 뒤 오른쪽 돌판을 밟고 능력을 해제한다. 전기가 지나간 뒤 왼쪽 돌판을 밟으면 완료)"},{"k":"해당 적은응결 피해 저항이 증가한다.\n꿈의 노드로 구성된 네트워크에 숨겨져 있는 특수 잔상, 어떤 부정적인 감정이 모여 있는 주파수이다"},{"k":"표시 근처 몬스터를 처치하면 해제"},{"k":"표시 근처 몬스터를 처치하면 해제. 통로 안에 있다"},{"k":"표시 근처의 적을 처치하면 열린다."},{"k":"흑조가 얼굴에서 벗겨지고 막다른 길에 이른 그는 마침내 맑은 정신을 되찾았다. 몸은 사라져도 희망과 구원은 남길 수 있다.\n그는 어두운 바다 밑에서 영원히 잠들 것이다. 그곳 또한 돌아갈 곳이다."},{"k":"구름 바다에 서식하던 울림 생물이었으나, 주파수 붕괴로 인해 잔상으로 변하며 슬픔 속에 매일을 지낸다"},{"k":"해당 적은 응결 피해 저항이 증가한다. \n어린 드레이크 형태의 잔상, 발톱 사이엔 뼈를 찌르는 서리가 돌고 있으며 군집의 형식으로 야외에서 활약한다.\n몸집의 크기와는 달리 영역 본능을 갖고 있고 숨결을 내쉬고 물어뜯기로 공격을 하며 무단 침입자를 쫓아내기 전에 절대 가만있지 않는다"},{"k":"어린 드레이크 형태의 잔상, 발톱 사이엔 뼈를 찌르는 서리가 돌고 있으며 군집의 형식으로 야외에서 활약한다"},{"k":"해당 적은 회절 피해 저항이 증가한다. \n우인 황철석을 등에 지고 있는 암괴 형상의 잔상, 채굴되지 않은 거친 금광으로 자주 오해를 받곤 한다.\n금석 암괴는 평생 등에 지고 있는 우인 황철석을 연마하는데 빠져있는데, 우인 황철석이 더욱 눈부신 빛을 띠게 한다"},{"k":"해당 적은 응결 피해 저항이 증가한다.\n운모 암석을 등에 지고 있는 암괴 형상의 잔상, 암석 속에는 구름 바다의 에너지가 흐르고 있는데, 마치 예측할 수 없는 진줏빛과도 같다.\n자극을 받으면, 유약 암괴의 등에 있는 암석체는 눈부신 빛을 뿜어낸다"},{"k":"어린 드레이크 형태의 잔상, 발톱 사이엔 세찬 천둥소리가 돌고 있으며 군집의 형식으로 야외에서 활약한다."},{"k":"22층 · 평소에는 검을 든 장엄한 조각상처럼, 조용히 수도회를 도와 라군나 성의 조화와 치안을 유지한다\n의심스러운 사람이나 에코를 발견하면 즉시 체포해 계령원으로 데려가 심판함으로써 성 안의 평온이 깨지지 않도록 한다."},{"k":"22층 · 꼭 주의! 먼저 그림 2 위치로 가서 그림 3 오른쪽 큰 문과 상호작용해 이 구역으로 이동해야 갈 수 있다. 평소에는 검을 든 장엄한 조각상처럼, 조용히 수도회를 도와 라군나 성의 조화와 치안을 유지한다.\n의심스러운 사람이나 에코를 발견하면 즉시 체포해 계령원으로 데려가 심판함으로써 성 안의 평온이 깨지지 않도록 한다."},{"k":"22층 · 꼭 주의! 먼저 그림 2 위치로 가서 그림 3 오른쪽 큰 문과 상호작용해 이 구역으로 이동해야 갈 수 있다. 표시된 구역은 복도 왼쪽에서 로프로 들어가야 한다. 평소에는 검을 든 장엄한 조각상처럼, 조용히 수도회를 도와 라군나 성의 조화와 치안을 유지한다. 의심스러운 사람이나 에코를 발견하면 즉시 체포해 계령원으로 데려가 심판함으로써 성 안의 평온이 깨지지 않도록 한다."},{"k":"22층 · 꼭 주의! 먼저 그림 2 위치로 가서 그림 3 오른쪽 큰 문과 상호작용해 이 구역으로 이동해야 갈 수 있다. 평소에는 검을 든 장엄한 조각상처럼, 조용히 수도회를 도와 라군나 성의 조화와 치안을 유지한다. 의심스러운 사람이나 에코를 발견하면 즉시 체포해 계령원으로 데려가 심판함으로써 성 안의 평온이 깨지지 않도록 한다."},{"k":"해당 적은 인멸 피해 저항이 증가한다.\n꿈의 노드로 구성된 네트워크에 숨겨져 있는 특수 잔상, 어떤 부정적인 감정이 모여 있는 주파수이다"},{"k":"해당 적은 기류 피해 저항이 증가한다.\n곰의 형태를 한 포악한 잔상, 머리, 목, 어깨와 팔에 화살촉 모양의 날카로운 흑석이 덮여있고, 날려 치는 힘은 마치 광풍의 급습과도 같다"}],"markers":[["1417920620236451840",0,7066.7,5340.7,"0",0,0],["1417920674619760640",0,7076.3,5334.6,"0",0,0],["1417920706794303488",0,7076.8,5343.9,"0",0,0],["1417921356693319680",0,6798.9,5098.8,"0",0,0],["1417921405523406848",0,6815.7,5099.2,"0",0,0],["1417921452600274944",0,6811.1,5084.9,"0",0,0],["1417921488474157056",0,6808.6,5092.1,"0",0,0],["1417921923884855296",0,6942.3,5003.8,"0",0,0],["1417921986950410240",0,6943.3,4994.4,"0",0,0],["1417922371127685120",0,6885.3,5226.1,"0",0,0],["1417922446155395072",0,6884.7,5232.6,"0",0,0],["1417922729489018880",0,7252.4,5152.5,"0",0,0],["1417922797646458880",0,7263.0,5152.4,"0",0,0],["1417922849307664384",0,7258.0,5154.7,"0",0,0],["1396977943255089152",1,7165.0,5330.8,"0",1,0],["1395424710622920704",2,7193.0,5071.5,"0",-1,0],["1395426954009329664",2,7212.0,5103.1,"0",-1,0],["1395427747169730560",2,7221.9,5152.8,"0",-1,0],["1395428523363434496",2,7235.5,5156.4,"0",-1,0],["1395429734120587264",2,7240.0,5144.7,"0",-1,0],["1395441677069139968",2,7187.6,5174.5,"0",-1,0],["1395511070084726784",2,6817.1,5228.7,"0",-1,0],["1395511797464383488",2,6840.6,5198.0,"0",-1,0],["1395518101730525184",2,7060.2,5206.1,"0",-1,0],["1395525311109955584",2,7060.2,5133.9,"0",-1,0],["1395526275287433216",2,7090.9,5070.6,"0",-1,0],["1395526942576771072",2,7077.3,4996.5,"0",-1,0],["1395527948466601984",2,7011.4,5007.4,"0",-1,0],["1396115716020322304",2,7202.9,5272.1,"0",-1,0],["1396116985048940544",2,7189.4,5255.8,"0",-1,0],["1396135845361827840",2,8303.4,3868.9,"0",-1,0],["1396986164334198784",2,8309.8,3868.0,"0",-1,0],["1396987250247892992"