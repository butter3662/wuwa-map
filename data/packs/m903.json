s/icons/f25645bab686c5bd36b2.webp"},{"id":"xlzm","n":"순례의 꿈","g":"exploration","c":"#f8c963","i":"tiles/icons/da33ca06eb9548216814.webp"},{"id":"ych","n":"다채화","g":"exploration","c":"#b8a1ff","i":"tiles/icons/a882a011b8c926eaf7ed.webp"},{"id":"cx_01","n":"조석의 유산 · 초록","g":"collection","c":"#f07e83","i":"tiles/icons/1b956f2f5d2ab8f86ef4.webp"},{"id":"wzjs_xg","n":"코이르키토르 · 선언","g":"elite-enemies","c":"#6cc8ee","i":"tiles/icons/aca132b5b95e3d028ec6.webp"},{"id":"cbd","n":"보물 지점","g":"exploration","c":"#9fdb72","i":"tiles/icons/5111afe1ca71aba1d1e3.webp"},{"id":"cx_03","n":"조석의 유산 · 금","g":"collection","c":"#8bd3c7","i":"tiles/icons/0c7537783a162a18228c.webp"},{"id":"CS_02","n":"소형 비콘","g":"exploration","c":"#f8c963","i":"tiles/icons/ace53ba2750c41850ccd.webp"},{"id":"CS_01","n":"중추 비콘","g":"exploration","c":"#b8a1ff","i":"tiles/icons/35bb0bb1bbd2f285b3bf.webp"},{"id":"cx_02","n":"조석의 유산 · 보라","g":"collection","c":"#f07e83","i":"tiles/icons/59f0eaade75ad1457a7e.webp"},{"id":"SP_IconMonsterHead_31057_UI","n":"드레이크 · 응결","g":"enemies","c":"#6cc8ee","i":"tiles/icons/0c7a54e50bc0c14d21d1.webp"},{"id":"fyjs","n":"비행 레이스","g":"exploration","c":"#9fdb72","i":"tiles/icons/0d70a9276d031ce1ffa8.webp"},{"id":"gtyl","n":"셀레스티얼 드레이크","g":"elite-enemies","c":"#8bd3c7","i":"tiles/icons/89b0aa00a87f0c8aba07.webp"},{"id":"hcjs","n":"곤돌라 레이스","g":"exploration","c":"#f8c963","i":"tiles/icons/2bba5da0e6d874f3e244.webp"},{"id":"SP_IconMonsterHead_31056_UI","n":"드레이크 · 전도","g":"enemies","c":"#b8a1ff","i":"tiles/icons/9bbaa5b7cb0b6286878c.webp"},{"id":"SP_IconMonsterHead_31054_UI","n":"사체르도스","g":"enemies","c":"#f07e83","i":"tiles/icons/1ae79b9649397accb3ea.webp"},{"id":"SP_IconMonsterHead_31052_UI","n":"라 과디어","g":"enemies","c":"#6cc8ee","i":"tiles/icons/a8417e504aaea1dfd5db.webp"},{"id":"T_IconTask_Task_144_UI","n":"부유 바다꽃","g":"resources","c":"#9fdb72","i":"tiles/icons/3d4fc097f957e316d0ae.webp"}],"def":["qzx_01","qzx_02","qzx_03","qzx_04"],"layers":[],"areas":[{"n":"서문의 도서관 · 유적","b":{"minX":1058.0330000000001,"minY":1837.779,"maxX":2360.922,"maxY":3171.388}},{"n":"영예의 방 · 유적","b":{"minX":2225.312,"minY":1977.826,"maxX":3537.3179999999998,"maxY":3424.078}},{"n":"자르곤 가든 · 유적","b":{"minX":1612.8,"minY":1047.191,"maxX":2800.941,"maxY":2201.901}},{"n":"연결의 탑","b":{"minX":2107.799,"minY":1470.9460000000001,"maxX":3436.122,"maxY":2379.987}},{"n":"성언의 방","b":{"minX":1717.808,"minY":1820.594,"maxX":2877.687,"maxY":2698.969}},{"n":"향상의 탑","b":{"minX":1900.4389999999999,"minY":2352.791,"maxX":3174.027,"maxY":3584.301}},{"n":"구원의 탑","b":{"minX":1290.24,"minY":1424.839,"maxX":2294.965,"maxY":2594.936}},{"n":"신성한 방","b":{"minX":1717.6090000000002,"minY":2059.1440000000002,"maxX":2855.803,"maxY":2986.165}}],"descs":[{"p":"","o":"（标点由玩家空跡提供）","l":"zh-CN"},{"k":"하부 중력 방향. 신성한 방 왼쪽 아래 비콘으로 이동한 뒤 앞으로 간다."},{"k":"하부 중력 방향. 신성한 방 왼쪽 아래 비콘으로 이동한 뒤 세 번째 그림에서 장리가 바라보는 방향으로 간다. 단 하나를 내려가야 한다. (몬스터가 지킴)"},{"k":"하부 중력 방향. 신성한 방 왼쪽 아래 비콘으로 이동한다.\n두 번째 그림에서 장리 맞은편 돌 아치 다리. 장리가 바라보는 방향 기준으로 보물상자 왼쪽 기둥의 단 위(그림 3 빨간 화살표)."},{"k":"상부 중력. 중추 비콘으로 이동한 뒤 왼쪽 앞의 돌 단상으로 날아간다.\n돌 단상 풀숲 속. (내가 아름다운 걸 보는 눈은 꽤 괜찮은 듯)"},{"k":"하부 중력. 향상의 탑 비콘으로 이동해 날아오면 나무뿌리 쪽. 드레이크 3마리를 처치해야 한다"},{"k":"하부 중력. 향상의 탑 비콘으로 이동해 날아오면, 섬 한가운데 나뭇가지 위"},{"k":"하부 중력. 향상의 탑 비콘으로 이동해 날아오면, 섬 정남쪽(지도 아래쪽)이자 나무의 정남쪽(나무 아래)"},{"k":"하부 중력. 검의 대전 비콘으로 이동한 뒤 이 방향으로 활공한다.\n보물상자는 이 구역 가장 아래, 즉 1층에 있다.\n몬스터를 처치하면 열 수 있다(라 과디어 2마리, 사지타리오 2마리)."},{"k":"하부 중력 구역. 보물상자는 두 번째 그림에서 가주 맞은편 단 위."},{"k":"하부 중력 구역. 벽을 타고 올라가야 하며 나뭇잎에 일부 가려져 있다. 정 못 찾겠으면 스캔을 켤 것."},{"k":"하부 중력 구역. 이 보물 지점의 가장 높은 곳."},{"p":"","o":"这里打完怪有个挑战，躲避雷电，就可以得到宝箱，加油哦。（随便玩，只要不被击出圈外就行）","l":"zh-CN"},{"k":"평지 위, 잠긴 보물상자 맞은편. 이 보물상자는 바로 열 수 있다"},{"k":"위쪽 돌기둥 위치."},{"k":"하부 중력 구역. 특별히 설명할 것 없이 오자마자 보인다. 옆에 사절이 잔뜩 있다."},{"k":"하부 중력 구역.\n두 번째 그림에서 장리가 서 있는 중력 전환 비콘으로 간다. 비콘은 건드리지 말고 앞으로 쭉 간 뒤 오른쪽으로 돌아 계단을 오른다."},{"k":"하부 중력 구역.\n먼저 향상의 탑 왼쪽 비콘으로 이동한 뒤 곤돌라를 소환한다.\n곤돌라를 몬다.\n두 번째 그림의 빨간 선 경로를 따라가고, 원 위치에서 한 번 점프한다.\n오른쪽 작은 단으로 가도 되지만 중력이 뒤집혀 설명하기 어렵다.\n아니면 그 자리에서 날아와도 된다.\n검을 든 조각상 바로 아래."},{"k":"보물상자는 상부 중력 방향에 있지만, 먼저 하부 중력 방향으로 와서 두 번째 그림 위치로 간다.\n두 번째 그림으로 오는 길은 이 표시와 아주 가까운 다른 보물상자 지점에 자세히 설명해 두었다.\n두 번째 그림 오른쪽의 보라색 원 쪽으로 몰고 가서 곤돌라로 도약하면 세 번째 그림 위치에 오며, 보물상자는 맞은편에 있다."},{"k":"하부 중력 구역. 이곳의 작은 용 5마리(드레이크 · 기류 2, 드레이크 · 전도 2, 드레이크 · 응결 1)를 처치하면 도전 【역린의 뇌겁】이 시작된다(제한 시간 동안 번개 공격 피하기)."},{"k":"상부 중력 구역 서적관 비콘으로 이동해 곤돌라를 소환해 몰고 온다. 조각상 바로 아래"},{"k":"단 정중앙. 몬스터도 매복도 확실히 없다"},{"k":"용 계열 작은 몬스터 3마리를 처치하면 도전이 시작된다. 정해진 시간 안에 벼락을 피해야 하며, 이벤트 페이지의 도전 목적지 안내로 위치를 추적할 수 있다"},{"k":"소형 비콘 북쪽(앞쪽)"},{"p":"","o":"直接来这里就行，不用动扶风转标。（跟着主线走就能拿到）","l":"zh-CN"},{"k":"보물상자는 상부 중력 구역에 있지만, 먼저 하부 중력 정원 쪽 비콘으로 이동한다.\n첫 번째 그림의 중력 전환기로 온다. 이 위치에는 중력 전환기가 두 개 있는데, 전환점이 두 개뿐인 중력 전환기를 돌려야 한다.\n파란색·흰색을 초록색으로 바꾸면 두 번째 그림 모습이 된다."},{"k":"중력 전환기 남쪽 (지도 아래 방향)"},{"k":"보물상자는 상부 중력 구역에 있지만, 먼저 하부 중력 구역 정원 비콘으로 이동해 비콘 바로 아래의 중력 전환기(그림 2 위치)로 간다.\n중력 전환기를 돌려 초록색으로 바꾼다. 그다음 그림 3 시점으로 앞으로 쭉 가면 보물상자가 보인다. 보물상자는 정면에 있으며 근처에 벽등과 항아리가 있다. 떨어지지 않게 주의."},{"p":"","o":"这个宝箱不用转扶风转标，下重力状态直接过来","l":"zh-CN"},{"k":"여기 와서 작은 용 4마리를 처치하면 도전 「빛의 번개 도전」이 자동으로 시작된다. 번개 공격을 피해 통과하면 얻는다"},{"k":"두 번째 그림 위치로 오면 지금은 하부 중력 구역에 있다. 중력 전환기를 돌려 초록색 아래 방향(측면 중력)으로 맞춘다.\n그러면 세 번째 그림 모습이 된다. 풍경을 대조해 문제가 없는지 확인한 뒤 세 번째 그림 위치에서 바로 아래로 뛰어내리면 된다."},{"k":"하부 중력 구역. 사절 3명을 처치하면 보물상자가 열린다. (이 표시를 제보해 주신 분들께 감사)"},{"k":"성녀 주간 보스 건물 꼭대기 흰 단의 창문 쪽. 전경 그림 3에 빨간 화살표로 표시 (표시는 플레이어 제공)"},{"k":"꾹꾹복어 도전을 완료하면 보물상자를 얻는다 (표시 위치가 보물상자 위치, 시작 지점은 그림 참고, 표시는 플레이어 제공)"},{"k":"위험한 임무 「별똥별이 밝게 빛난다면」 중 도전으로 얻는다 (표시는 플레이어 제공)"},{"k":"위험한 임무 「별똥별이 밝게 빛난다면」 도전을 완료하면 얻는다 (표시는 플레이어 제공)"},{"k":"상부 중력 구역. 지도 왼쪽 비콘으로 이동해 아무 단에서나 뛰어내려 공중 섬 쪽으로 날아가면 된다. 업적 「조류 장난감」 보물 획득"},{"k":"해당 적은 회절 피해 저항이 증가한다. \n활과 화살을 지닌 조각상, 라군나를 감시하는 동시에 수도회와 연락하는 직책을 맡고 있다.\n의심스러운 사람이나 에코를 발견하면 즉시 체포하고 계령원에 송치해 심판을 집행하여 성 내의 평안이 파괴되지 않도록 보장한다"},{"k":"상부 중력 방향. 중추 비콘으로 이동한 뒤 돌 단상 위로 날아오른다."},{"k":"보면 바로 알 것이다."},{"k":"상부 중력 구역. 상부 중력 구역 중추 비콘으로 이동한 뒤 활공해 오면 정중앙에 있다."},{"k":"이 보물상자는 두 번째 그림 파란 원 위치의 도전 보물상자다. 칸타렐라가 있는 위치가 도전 출발점"},{"k":"이 보물상자는 두 번째 그림의 도전 보물상자다. 출발점은 그림 3 참고"},{"k":"이 보물상자는 두 번째 그림 동그라미 위치의 도전 보물상자다. 그림 3의 조각상 가슴 앞 단이 출발점"},{"k":"가운데 위쪽 중추 비콘으로 이동한 뒤 왼쪽 앞으로 날아오면 떠 있는 돌 단상들 위."},{"k":"상부 중력. 중추 비콘으로 이동한 뒤 왼쪽 앞의 떠 있는 돌 단상으로 날아간다."},{"k":"성녀 주간 보스로 이동한다. 주간 보스 입구의 다리 아래."},{"k":"하부 중력 구역. 보물상자는 두 번째 그림에서 가주 맞은편 떠 있는 단 위."},{"k":"먼저 하부 중력 구역으로 와서 두 번째 그림의 장리 위치에서 중력 전환기를 돌려 중력을 뒤집으면 상부 중력 구역으로 온다.\n중력을 바꾸면 세 번째 그림 모습이 된다. 아래층으로 내려가 모퉁이를 돌면 보물상자가 보인다."},{"k":"하부 중력 구역.\n이 상자는 이 구역 가장 높은 곳에 있다. 두 번째 그림의 장리 위치로 와서 왼쪽 벽을 타고 올라가 스캔을 켜면 찾는다. (활공으로 날아와도 된다) 상자 앞에 몬스터가 많지만 처치하지 않고 바로 열고 떠나도 된다."},{"k":"먼저 하부 중력 구역으로 와서 두 번째 그림의 장리 위치에서 중력 전환기를 돌려 중력을 뒤집으면 상부 중력 구역으로 온다.\n중력을 바꾸면 세 번째 그림 모습이 된다. 직진해 계단을 내려가 시선을 오른쪽으로 본다(세 번째 그림 모습).\n가주 맞은편 원 안으로 날아간 뒤 직진하지 말고 오른쪽으로 돌면 끝에 소박한 보물상자가 있다."},{"k":"보물상자는 하부 중력 구역에 있지만, 먼저 상부 중력 구역 공방 비콘으로 이동한다.\n이동한 뒤 중력 전환기로 가서 중력을 뒤집는다.\n두 번째 그림 위치로 오면 보물상자는 춘 맞은편 떠 있는 단 위에 있다."},{"k":"상부 중력 보물상자. 상부 중력 구역 왼쪽 비콘으로 이동하면 보물상자는 중력 전환기의 서쪽(왼쪽)에 있다."},{"k":"하부 중력 방향. 먼저 구원의 탑 왼쪽으로 이동한 뒤, 두 번째 그림에서 가주가 바라보는 방향의 복도로 간다. 그러면 세 번째 그림 위치가 나오고, 보물상자는 세 번째 그림에서 가주 바로 맞은편 늙은 말 조각상 아래."},{"k":"하부 중력 구역. 두 번째 그림 위치로 오면 상자는 가주가 바라보는 방향 왼쪽 기둥 위."},{"k":"두 번째 그림 위치로 와서 가주가 정면으로 바라보는 방향의 대문 입구에서 아무 위치나 골라 올라가면 꽃 뒤편에서 보물상자를 찾는다."},{"k":"상부 중력 구역. 상부 중력 구역 왼쪽 비콘으로 이동한 뒤, 두 번째 그림에서 장리가 바라보는 방향으로 뛰어내려 활공하고, 마지막에 왼쪽으로 날아가면 찾을 수 있다. 건물 맨 위"},{"k":"해당 적은 기류 피해 저항이 증가한다. \n어린 드레이크 형태의 잔상, 발톱 사이엔 빠른 기류가 돌고 있으며 군집의 형식으로 야외에서 활약한다.\n몸집의 크기와는 달리 영역 본능을 갖고 있고 숨결을 내쉬고 물어뜯기로 공격을 하며 무단 침입자를 쫓아내기 전에 절대 가만있지 않는다"},{"k":"메인 스토리를 완료해 부서진 건물을 복구하면 검을 뽑는 위치 근처에 나타난다. 소형 비콘 동쪽(오른쪽)이다"},{"k":"만들어낸 성녀, 신이 지정한 용기.\n그녀의 탄생은 잘 꾸며낸 한차례의 음모이고, 그녀의 인생은 실로 조종된 한 편의 꼭두각시 연극이다.\n그녀가 자신의 꾸며낸 과거를 직면하고, 진정으로 원하는 미래를 찾을 때면 수중의 검은 운명의 족쇄를 잘라낼 것이다.\n지금의 그녀에겐 한차례의 죽음이 필요하다"},{"k":"표시 근처에서 도전 범위에 들어가면 도전이 시작된다"},{"k":"준비하고 강적을 처치하자 (처치하면 금색 조석의 유산이 해제된다)"},{"k":"표시 주변을 떠도는 반딧불. 방랑자여, 잡아라!"},{"k":"표시 주변을 떠도는 반딧불. 방랑자, 잡아 보자!\n구름 위"},{"k":"표시 위치 가운데 기둥과 상호작용해 도전을 시작한다. 처음으로 노드 목표 3개를 완료하면 조석의 유산 3개 획득"},{"p":"","o":"解密地点在标点处的最底层。解法可参考图2，按照颜色顺序点击箭头所指位置即可","l":"zh-CN"},{"k":"그림 2 참고. 색깔 순서대로 화살표가 가리키는 위치를 누르면 된다."},{"k":"순례의 꿈 도전 세 개를 한 번에 모두 완료하면 업적 「그 큰 일을 행하신 떠도는 자」가 해제된다"},{"k":"도전 【꿈의 노드 · 연결의 땅】의 노드 목표 1개를 완료하면 열 수 있다"},{"k":"공중에 떠 있는 섬 위. 가운데 기둥과 상호작용하면 도전이 시작되고, 【순례의 꿈 · 라군나 편】 노드 1개를 완료하면 열 수 있다"},{"p":"","o":"该藏宝地共3处宝箱 可通过大地图或游戏内通过【感知】查找（该藏宝地处于下重力）","l":"zh-CN"},{"p":"","o":"该藏宝地共4处宝箱 可通过大地图或游戏内通过【感知】查找（该藏宝地处于下重力）","l":"zh-CN"},{"p":"","o":"该藏宝地共4处宝箱 可通过大地图或游戏内通过【感知】查找（该藏宝地处于下重力 该区域宝箱较难寻找，可查询相关攻略辅助寻找）","l":"zh-CN"},{"p":"","o":"该藏宝地共4处宝箱 可通过大地图或游戏内通过【感知】查找（该藏宝地处于上重力）","l":"zh-CN"},{"p":"","o":"该藏宝地共5处宝箱 可通过大地图或游戏内通过【感知】查找（该藏宝地处于上重力）","l":"zh-CN"},{"k":"강적을 처치하면 얻는다"},{"k":"떠 있는 섬 중앙. Lv.120 붉은 이름 몬스터 3마리를 처치하면 해제되며 업적 【최후의 선고가 아니다】도 해제할 수 있다"},{"k":"Lv.120 붉은 이름 몬스터 【코이르키토르 · 심판】 3마리를 처치하면 열리며 업적 【최후의 심판이 아니다】를 달성한다"},{"k":"도전 【꿈의 노드 · 영예의 땅】의 목표 노드 1개를 완료하면 열 수 있다. 노드 목표 3개를 한 번에 완료하면 업적 【그 큰 일을 행하신 떠도는 자】를 달성할 수 있다"},{"k":"도전 【꿈의 노드 · 연결의 땅】의 노드 목표 3개를 완료하면 열 수 있다"},{"k":"공중에 떠 있는 섬 위. 가운데 기둥과 상호작용하면 도전이 시작되고, 【순례의 꿈 · 라군나 편】 노드 3개를 완료하면 열 수 있다"},{"p":"","o":"这时颠倒重力之后，箭头朝上的那一面。","l":"zh-CN"},{"k":"도전 【꿈의 노드 · 영예의 땅】의 목표 노드 2개를 완료하면 열 수 있다. 노드 목표 3개를 한 번에 완료하면 업적 【그 큰 일을 행하신 떠도는 자】를 달성할 수 있다"},{"k":"도전 【꿈의 노드 · 연결의 땅】의 노드 목표 2개를 완료하면 열 수 있다"},{"k":"공중에 떠 있는 섬 위. 가운데 기둥과 상호작용하면 도전이 시작되고, 【순례의 꿈 · 라군나 편】 노드 2개를 완료하면 열 수 있다"},{"k":"해당 적은 응결 피해 저항이 증가한다. \n어린 드레이크 형태의 잔상, 발톱 사이엔 뼈를 찌르는 서리가 돌고 있으며 군집의 형식으로 야외에서 활약한다.\n몸집의 크기와는 달리 영역 본능을 갖고 있고 숨결을 내쉬고 물어뜯기로 공격을 하며 무단 침입자를 쫓아내기 전에 절대 가만있지 않는다"},{"k":"해당 적은 전도 피해 저항이 증가한다. \n어린 드레이크 형태의 잔상, 발톱 사이엔 세찬 천둥소리가 돌고 있으며 군집의 형식으로 야외에서 활약한다.\n몸집의 크기와는 달리 영역 본능을 갖고 있고 숨결을 내쉬고 물어뜯기로 공격을 하며 무단 침입자를 쫓아내기 전에 절대 가만있지 않는다"},{"k":"표시 근처에서 「케루브 따라가기」로 도전을 시작한다"},{"p":"","o":"该挑战位置位于上重力区域 请注意切换重力方向后追踪前往","l":"zh-CN"},{"k":"표시 근처에서 도전을 시작한다. 처음 완료하면 보물상자를 얻는다"},{"p":"","o":"象征着慈爱的塑像，聆听着拉古那人民对修会的祷告与颂赞。\n具体位置在河道的中间有个拿剑的半身巨型骑士像处起飞，往右上方冲刺会看到一个图一的画面就是走对了。图二为俯视图方便找位置","l":"zh-CN"},{"k":"해당 적은 기류 피해 저항이 증가한다. \n자애를 상징하는 조각상, 라군나 사람들의 수도회를 향한 기도와 찬송을 경청한다.\n의심스러운 사람이나 에코를 발견하면 즉시 체포하고 계령원에 송치해 심판을 집행하여 성 내의 평안이 파괴되지 않도록 보장한다"},{"k":"가장 아래층 거상 앞 물길에서 꺾어 온다 (그림 2 참고)\n자애를 상징하는 조각상으로, 라군나 사람들이 수도회에 바치는 기도와 찬미를 듣는다. 수상한 인물이나 에코를 발견하면 즉시 붙잡아 계령원으로 데려가 심판을 받게 해, 도시의 안정이 흔들리지 않도록 지킨다."},{"k":"가장 아래층 거상 앞 물길에서 왼쪽으로 꺾어 들어온다. 강가 길 위 (그림 2 참고)\n자애를 상징하는 조각상으로, 라군나 사람들이 수도회에 바치는 기도와 찬미를 듣는다. 수상한 인물이나 에코를 발견하면 즉시 붙잡아 계령원으로 데려가 심판을 받게 해, 도시의 안정이 흔들리지 않도록 지킨다."},{"k":"가장 아래층 거상 앞 물길에서 왼쪽으로 꺾어 들어온다. 강가 길 위 (그림 2 참고) 자애를 상징하는 조각상으로, 라군나 사람들이 수도회에 바치는 기도와 찬미를 듣는다. 수상한 인물이나 에코를 발견하면 즉시 붙잡아 계령원으로 데려가 심판을 받게 해, 도시의 안정이 흔들리지 않도록 지킨다."},{"k":"가장 아래층 거상 앞 물길에서 왼쪽으로 꺾어 들어온다. 그림 2의 텔레포트 지점에서 그림 3 끝까지 가서 아래로 떨어지면 숨겨진 수로에 닿는다. 자애를 상징하는 조각상으로, 라군나 사람들이 수도회에 바치는 기도와 찬미를 듣는다. 수상한 인물이나 에코를 발견하면 즉시 붙잡아 계령원으로 데려가 심판을 받게 해, 도시의 안정이 흔들리지 않도록 지킨다."},{"k":"평소에는 검을 든 장엄한 조각상처럼, 조용히 수도회를 도와 라군나 성의 조화와 치안을 유지한다.\n의심스러운 사람이나 에코를 발견하면 즉시 체포하고 계령원에 송치해 심판을 집행하여 성 내의 평안이 파괴되지 않도록 보장한다"},{"k":"가장 아래층 방 안. 안의 미믹을 건드리면 살아난다"}],"markers":[["1358868362183401472",0,2260.6,2512.0,"0",-1,0],["1527457975621111808",0,1947.1,2681.7,"0",0,0],["1527459215281864704",0,2620.2,1865.8,"0",0,0],["1527459638733950976",0,1813.4,1987.8,"0",0,0],["1527460100988846080",0,2395.3,2903.0,"0",-1,0],["1527460454736445440",0,2883.2,2583.2,"0",-1,0],["1527460773574852608",0,2304,1713.1,"0",-1,0],["1527465951493472256",0,1669.7,2416.0,"0",-1,0],["1531770380891537408",0,1679.4,2216.3,"0",-1,0],["1531770485791080448",0,2095.7,1836.0,"0",-1,0],["1358821665315053568",1,2298.4,1834.1,"0",-1,0],["1354838564342779904",2,2288.6,2546.1,"0",1,0],["1354839327601250304",2,2340.1,2548.0,"0",2,0],["1354840663894581248",2,2318.5,2549.8,"0",3,0],["1354843051929952256",2,2389.8,2713.3,"0",4,0],["1354846509944197120",2,2310.3,3215.7,"0",5,0],["1354847068382879744",2,2292.3,3228.3,"0",6,0],["1354847529320112128",2,2303.1,3261.7,"0",7,0],["1354849496062152704",2,3081.0,2668.1,"0",8,0],["1354850151590584320",2,3115.4,2660.9,"0",9,0],["1354850786771787776",2,3117.2,2666.3,"0",10,0],["1354851223888908288",2,3110.9,2652.8,"0",11,0],["1354852160762