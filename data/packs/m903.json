s/icons/f25645bab686c5bd36b2.webp"},{"id":"xlzm","n":"순례의 꿈","g":"exploration","c":"#f8c963","i":"tiles/icons/da33ca06eb9548216814.webp"},{"id":"ych","n":"다채화","g":"exploration","c":"#b8a1ff","i":"tiles/icons/a882a011b8c926eaf7ed.webp"},{"id":"cx_01","n":"조석의 유산 · 초록","g":"collection","c":"#f07e83","i":"tiles/icons/1b956f2f5d2ab8f86ef4.webp"},{"id":"wzjs_xg","n":"코이르키토르 · 선언","g":"elite-enemies","c":"#6cc8ee","i":"tiles/icons/aca132b5b95e3d028ec6.webp"},{"id":"cbd","n":"보물 지점","g":"exploration","c":"#9fdb72","i":"tiles/icons/5111afe1ca71aba1d1e3.webp"},{"id":"cx_03","n":"조석의 유산 · 금","g":"collection","c":"#8bd3c7","i":"tiles/icons/0c7537783a162a18228c.webp"},{"id":"CS_02","n":"소형 비콘","g":"exploration","c":"#f8c963","i":"tiles/icons/ace53ba2750c41850ccd.webp"},{"id":"CS_01","n":"중추 비콘","g":"exploration","c":"#b8a1ff","i":"tiles/icons/35bb0bb1bbd2f285b3bf.webp"},{"id":"cx_02","n":"조석의 유산 · 보라","g":"collection","c":"#f07e83","i":"tiles/icons/59f0eaade75ad1457a7e.webp"},{"id":"SP_IconMonsterHead_31057_UI","n":"드레이크 · 응결","g":"enemies","c":"#6cc8ee","i":"tiles/icons/0c7a54e50bc0c14d21d1.webp"},{"id":"fyjs","n":"비행 레이스","g":"exploration","c":"#9fdb72","i":"tiles/icons/0d70a9276d031ce1ffa8.webp"},{"id":"gtyl","n":"셀레스티얼 드레이크","g":"elite-enemies","c":"#8bd3c7","i":"tiles/icons/89b0aa00a87f0c8aba07.webp"},{"id":"hcjs","n":"곤돌라 레이스","g":"exploration","c":"#f8c963","i":"tiles/icons/2bba5da0e6d874f3e244.webp"},{"id":"SP_IconMonsterHead_31056_UI","n":"드레이크 · 전도","g":"enemies","c":"#b8a1ff","i":"tiles/icons/9bbaa5b7cb0b6286878c.webp"},{"id":"SP_IconMonsterHead_31054_UI","n":"사체르도스","g":"enemies","c":"#f07e83","i":"tiles/icons/1ae79b9649397accb3ea.webp"},{"id":"SP_IconMonsterHead_31052_UI","n":"라 과디어","g":"enemies","c":"#6cc8ee","i":"tiles/icons/a8417e504aaea1dfd5db.webp"},{"id":"T_IconTask_Task_144_UI","n":"부유 바다꽃","g":"resources","c":"#9fdb72","i":"tiles/icons/3d4fc097f957e316d0ae.webp"}],"def":["qzx_01","qzx_02","qzx_03","qzx_04"],"layers":[],"areas":[{"n":"서문의 도서관 · 유적","b":{"minX":1058.0330000000001,"minY":1837.779,"maxX":2360.922,"maxY":3171.388}},{"n":"영예의 방 · 유적","b":{"minX":2225.312,"minY":1977.826,"maxX":3537.3179999999998,"maxY":3424.078}},{"n":"자르곤 가든 · 유적","b":{"minX":1612.8,"minY":1047.191,"maxX":2800.941,"maxY":2201.901}},{"n":"연결의 탑","b":{"minX":2107.799,"minY":1470.9460000000001,"maxX":3436.122,"maxY":2379.987}},{"n":"성언의 방","b":{"minX":1717.808,"minY":1820.594,"maxX":2877.687,"maxY":2698.969}},{"n":"향상의 탑","b":{"minX":1900.4389999999999,"minY":2352.791,"maxX":3174.027,"maxY":3584.301}},{"n":"구원의 탑","b":{"minX":1290.24,"minY":1424.839,"maxX":2294.965,"maxY":2594.936}},{"n":"신성한 방","b":{"minX":1717.6090000000002,"minY":2059.1440000000002,"maxX":2855.803,"maxY":2986.165}}],"descs":[{"p":"","o":"（标点由玩家空跡提供）","l":"zh-CN"},{"p":"","o":"下重力方向，传送到圣授厅左下方的信标，然后朝着前方走。","l":"zh-CN"},{"p":"","o":"下重力方向，传送到圣授厅左下方的信标，然后朝着第三张图长离面对方向走，需要下一个台子。（怪物镇守）","l":"zh-CN"},{"p":"","o":"下重力方向，传送到圣授厅左下方的信标。\n然后，第二张图长离对面的石拱桥，以长离面对方向为基准，宝箱左边柱子的台子上（图3红色箭头所指处）。","l":"zh-CN"},{"p":"","o":"上重力，传送到中枢信标位置，然后飞向左前方的石台。\n在石台的草丛中。（我发现美的眼睛还算不错的）","l":"zh-CN"},{"p":"","o":"下重力，传送到向上之塔的信标处，然后飞过来，在树根处，需要击败3条小翼龙","l":"zh-CN"},{"p":"","o":"下重力，传送到向上之塔的信标处，然后飞过来，在岛的正中间的树杈上","l":"zh-CN"},{"p":"","o":"下重力，传送到向上之塔的信标处，然后飞过来，在岛的正南方（地图下方），也在树的正南方（树下方）","l":"zh-CN"},{"p":"","o":"下重力，传送到剑授大厅的信标，然后朝着这个方向翱翔，\n宝箱在这片区域最下面的位置，也就是一层。\n清完怪后可开启（两只卫冕节使、两只赦罪节使）","l":"zh-CN"},{"p":"","o":"下重力区域。宝箱在第二张图，家住对面那个台子上。","l":"zh-CN"},{"p":"","o":"下重力区域。需要爬上墙壁上，被树叶挡着一部分，实在找不到的话，开一下感知。","l":"zh-CN"},{"p":"","o":"下重力区域。在这片藏宝地的最高处。","l":"zh-CN"},{"p":"","o":"这里打完怪有个挑战，躲避雷电，就可以得到宝箱，加油哦。（随便玩，只要不被击出圈外就行）","l":"zh-CN"},{"p":"","o":"在平地上，被锁住的宝箱对面，这个宝箱可以直接打开","l":"zh-CN"},{"p":"","o":"在上面的石柱位置上。","l":"zh-CN"},{"p":"","o":"下重力区域，这没啥可说的，一来就看到了。旁边有一大堆节使","l":"zh-CN"},{"p":"","o":"下重力区域。\n走到第二张图长离站的扶风信标处，不要去动扶风信标，一直朝面前走，然后右转上楼梯。","l":"zh-CN"},{"p":"","o":"下重力区域。\n首先，传送到向上之塔左边的信标，然后召唤神奇贡多拉。\n驾驶贡多拉。\n看一下第二张图，顺着红色线条的线路驾驶过去，圆圈位置需要跳跃一次。\n其实驾驶贡多拉走右边的小台子也可以，但是会颠倒重力，不容易描述。\n再或者，原地起飞，飞过来也可以。\n在执剑雕像正下方。","l":"zh-CN"},{"p":"","o":"宝箱在上重力方向，但我们先来下重力方向。来到第第二张图的位置。\n第二张图的来路，在这个标点很近的一个宝箱点有详细描述。\n朝着第二张图右边的紫色圆圈驾驶，然后贡多拉飞跃，就来到了第三张图的位置，宝箱就在对面。","l":"zh-CN"},{"p":"","o":"下重力区域，来这里击败五条小龙（两只小翼龙·气动、两只小翼龙·导电、一只小翼龙·冷凝），然后触发挑战【逆鳞雷劫】（限定时间内躲避闪电攻击）。","l":"zh-CN"},{"p":"","o":"传送到上重力区域扉页书馆的信标，召唤贡多拉，然后驾驶过来。在雕像的正下方","l":"zh-CN"},{"p":"","o":"平台正中间，非常确定没有怪没有埋伏","l":"zh-CN"},{"p":"","o":"击败三个龙小怪后开启挑战，规定时间内躲避雷击，可通过活动页面的挑战导航追踪位置","l":"zh-CN"},{"p":"","o":"小型信标的北方（前方）","l":"zh-CN"},{"p":"","o":"直接来这里就行，不用动扶风转标。（跟着主线走就能拿到）","l":"zh-CN"},{"p":"","o":"宝箱在上重力区域，但是我们先传送到下重力花园地方的信标i处。\n来到第一张图的扶风转标处，这个位置有两个扶风转标，我们需要转只有两个转点的扶风转标。\n把蓝白色改成绿色，就可以得到第二张图的效果。","l":"zh-CN"},{"p":"","o":"在扶风转标的南方（地图向下）","l":"zh-CN"},{"p":"","o":"宝箱在上重力区域，但是我们传送到下重力区域花园的信标，然后来到信标正下方的扶风转标（图二位置）。\n转动扶风转标，改成绿色。之后，如图三所示视角，向前一直走，就能看到宝箱。宝箱在正前方，附近有个壁灯和瓦罐,注意别掉下去了。","l":"zh-CN"},{"p":"","o":"这个宝箱不用转扶风转标，下重力状态直接过来","l":"zh-CN"},{"p":"","o":"来到这里，打完4只小龙之后，自动触发挑战“闪翼挑战”躲避闪电攻击，通关获得","l":"zh-CN"},{"p":"","o":"来到第二张图的位置，此时我们位于下重力区域，转动扶风转标，调到绿色向下（侧重力）。\n这样，就得到了第三张图的效果，各位对照一下景物，确保没有问题之后，从第三张图的位置，直接向下跳，就可以。","l":"zh-CN"},{"p":"","o":"下重力区域，击败3只节使解锁宝箱（感谢各位反馈这个标点。）","l":"zh-CN"},{"p":"","o":"位于圣女周本建筑顶部白色平台的窗户处，全景图3中用红色箭头指出（标点由玩家改文件用提供）","l":"zh-CN"},{"p":"","o":"完成咕咕河豚挑战获得宝箱（标点处为宝箱位置，起始点见图，标点由玩家改文件用提供）","l":"zh-CN"},{"p":"","o":"在危行任务-若流星盛放中挑战获得（标点由玩家改文件用提供）","l":"zh-CN"},{"p":"","o":"完成危行任务-若流星盛放挑战获得（标点由玩家改文件用提供）","l":"zh-CN"},{"p":"","o":"上重力区域，传送到地图左方向的信标，随便找个台子，然后跳下来，朝浮空岛屿这边飞就可以。获得成就“潮玩”奇藏","l":"zh-CN"},{"k":"해당 적은 회절 피해 저항이 증가한다. \n활과 화살을 지닌 조각상, 라군나를 감시하는 동시에 수도회와 연락하는 직책을 맡고 있다.\n의심스러운 사람이나 에코를 발견하면 즉시 체포하고 계령원에 송치해 심판을 집행하여 성 내의 평안이 파괴되지 않도록 보장한다"},{"p":"","o":"上重力方向，传送到中枢信标位置，然后飞上石台。","l":"zh-CN"},{"p":"","o":"显而易见了吧。","l":"zh-CN"},{"p":"","o":"上重力区域，传送到上重力区域的中枢信标位置，然后翱翔过来，正中央就是。","l":"zh-CN"},{"p":"","o":"此宝箱为第二张图篮圈位置的挑战宝箱。大坎所在的位置为挑战起点","l":"zh-CN"},{"p":"","o":"此宝箱为第二张图挑战宝箱。起点如图三所示","l":"zh-CN"},{"p":"","o":"此宝箱为第二张图画圈位置挑战宝箱。图3雕像胸前的平台为起点","l":"zh-CN"},{"p":"","o":"传送到中心向上的中枢信标，然后朝左前方飞过来，在那些漂浮的石台上。","l":"zh-CN"},{"p":"","o":"上重力，传送到中枢信标位置，然后朝着左前方浮空石台飞。","l":"zh-CN"},{"p":"","o":"传送到圣女周本这里，在周本门口在桥的下面。","l":"zh-CN"},{"p":"","o":"下重力区域，宝箱在第二张图，家主对面的那个漂浮台上。","l":"zh-CN"},{"p":"","o":"先来到下重力区域，来到第二张图张力这个位置，转动扶风信标，颠倒重力，这样我们就来到了上重力区域。\n转换重力后，就是第三张图的样子，走下楼，拐个角就能看到宝箱。","l":"zh-CN"},{"p":"","o":"下重力区域。\n这个宝箱在这个独域的最高处，来到第二张图长离的位置，顺着左手边的墙壁，爬上去，开感知就可以找到。（可以翱翔飞上来）宝箱的前方有很多怪，可以不清理直接开启走人","l":"zh-CN"},{"p":"","o":"先来到下重力区域，来到第二张图张力这个位置，转动扶风信标，颠倒重力，这样我们就来到了上重力区域。\n转换重力后，就是第三张图的样子，直走下楼梯，视野朝右方看（即第三张图的样子），\n飞到家主对面的圆圈里，之后不要直走，右拐尽头就是朴素宝箱。","l":"zh-CN"},{"p":"","o":"宝箱在下重力区域，但是我们先传送到上重力区域的作坊信标。\n传送之后，来到扶风转标这里，颠倒重力。\n来到第二张图的位置，宝箱在椿对面那个浮台上。","l":"zh-CN"},{"p":"","o":"上重力宝箱，传送到上重力区域的左方信标，宝箱就在扶风转标的西方向（左边）。","l":"zh-CN"},{"p":"","o":"下重力方向，先传送到拯救之塔左方向，然后朝着第二张图家主面对方向的那个走廊位置走。这样就可以来到第三张图的位置，宝箱在第三张图家主正对面老马雕像下面。","l":"zh-CN"},{"p":"","o":"下重力区域。来到第二张图的位置，宝箱在家主正对方向，左手边的柱子上。","l":"zh-CN"},{"p":"","o":"来到第二张图的位置，家主正对方向，大门门口，任选一个位置，爬上去，在花后背后，就能找到宝箱。","l":"zh-CN"},{"p":"","o":"上重力区域，传送到上重力区域左方向信标后，朝着第二张图长离正对方向的位置跳下去，然后翱翔，最后朝左手边飞，就可以找到。在建筑最上方","l":"zh-CN"},{"k":"해당 적은 기류 피해 저항이 증가한다. \n어린 드레이크 형태의 잔상, 발톱 사이엔 빠른 기류가 돌고 있으며 군집의 형식으로 야외에서 활약한다.\n몸집의 크기와는 달리 영역 본능을 갖고 있고 숨결을 내쉬고 물어뜯기로 공격을 하며 무단 침입자를 쫓아내기 전에 절대 가만있지 않는다"},{"p":"","o":"完成主线，将破碎的建筑恢复后，会在拔剑位置附近出现。就在小型信标的东面（右边）","l":"zh-CN"},{"k":"만들어낸 성녀, 신이 지정한 용기.\n그녀의 탄생은 잘 꾸며낸 한차례의 음모이고, 그녀의 인생은 실로 조종된 한 편의 꼭두각시 연극이다.\n그녀가 자신의 꾸며낸 과거를 직면하고, 진정으로 원하는 미래를 찾을 때면 수중의 검은 운명의 족쇄를 잘라낼 것이다.\n지금의 그녀에겐 한차례의 죽음이 필요하다"},{"p":"","o":"在标点附近进入挑战范围后即可开启挑战","l":"zh-CN"},{"p":"","o":"做好准备击败强敌吧（击败后可解锁潮汐之遗金）","l":"zh-CN"},{"k":"표시 주변을 떠도는 반딧불. 방랑자여, 잡아라!"},{"p":"","o":"在标点周围游荡的飞萤 漂泊者，捕捉它吧！\n云上","l":"zh-CN"},{"p":"","o":"与标点处中间的柱子互动开启挑战，首次完成挑战中三个节点后可获得三个潮汐之遗奖励","l":"zh-CN"},{"p":"","o":"解密地点在标点处的最底层。解法可参考图2，按照颜色顺序点击箭头所指位置即可","l":"zh-CN"},{"k":"그림 2 참고. 색깔 순서대로 화살표가 가리키는 위치를 누르면 된다."},{"p":"","o":"巡礼三个挑战一次全部完成可以解锁“荣光归于漂泊之人”成就","l":"zh-CN"},{"p":"","o":"完成挑战【梦境节点·联结之地】的一个节点目标可开启","l":"zh-CN"},{"p":"","o":"在空中浮岛上，与到中间的柱子互动开启挑战，完成挑战【巡礼之梦·拉古那篇】一个节点后可获得开启","l":"zh-CN"},{"p":"","o":"该藏宝地共3处宝箱 可通过大地图或游戏内通过【感知】查找（该藏宝地处于下重力）","l":"zh-CN"},{"p":"","o":"该藏宝地共4处宝箱 可通过大地图或游戏内通过【感知】查找（该藏宝地处于下重力）","l":"zh-CN"},{"p":"","o":"该藏宝地共4处宝箱 可通过大地图或游戏内通过【感知】查找（该藏宝地处于下重力 该区域宝箱较难寻找，可查询相关攻略辅助寻找）","l":"zh-CN"},{"p":"","o":"该藏宝地共4处宝箱 可通过大地图或游戏内通过【感知】查找（该藏宝地处于上重力）","l":"zh-CN"},{"p":"","o":"该藏宝地共5处宝箱 可通过大地图或游戏内通过【感知】查找（该藏宝地处于上重力）","l":"zh-CN"},{"p":"","o":"击败强敌后可获得","l":"zh-CN"},{"p":"","o":"在浮岛中央，击败三只红名120级红名怪后解锁，还可以解锁成就【并非最后的宣告】","l":"zh-CN"},{"p":"","o":"击败三名120级红名怪【妄罪节使·裁决】后可开启，并完成成就【并非最后的裁决】","l":"zh-CN"},{"p":"","o":"完成挑战【梦境节点·剑授之地】一个目标节点可开启；如果一次性完成三个节点目标可完成成就【荣光归于漂泊之人】","l":"zh-CN"},{"p":"","o":"完成挑战【梦境节点·联结之地】的三个节点目标可开启","l":"zh-CN"},{"p":"","o":"在空中浮岛上，与到中间的柱子互动开启挑战，完成挑战【巡礼之梦·拉古那篇】三个节点后可获得开启","l":"zh-CN"},{"p":"","o":"这时颠倒重力之后，箭头朝上的那一面。","l":"zh-CN"},{"p":"","o":"完成挑战【梦境节点·剑授之地】两个目标节点可开启；如果一次性完成三个节点目标可完成成就【荣光归于漂泊之人】","l":"zh-CN"},{"p":"","o":"完成挑战【梦境节点·联结之地】的两个节点目标可开启","l":"zh-CN"},{"p":"","o":"在空中浮岛上，与到中间的柱子互动开启挑战，完成挑战【巡礼之梦·拉古那篇】两个节点后可获得开启","l":"zh-CN"},{"k":"해당 적은 응결 피해 저항이 증가한다. \n어린 드레이크 형태의 잔상, 발톱 사이엔 뼈를 찌르는 서리가 돌고 있으며 군집의 형식으로 야외에서 활약한다.\n몸집의 크기와는 달리 영역 본능을 갖고 있고 숨결을 내쉬고 물어뜯기로 공격을 하며 무단 침입자를 쫓아내기 전에 절대 가만있지 않는다"},{"k":"해당 적은 전도 피해 저항이 증가한다. \n어린 드레이크 형태의 잔상, 발톱 사이엔 세찬 천둥소리가 돌고 있으며 군집의 형식으로 야외에서 활약한다.\n몸집의 크기와는 달리 영역 본능을 갖고 있고 숨결을 내쉬고 물어뜯기로 공격을 하며 무단 침입자를 쫓아내기 전에 절대 가만있지 않는다"},{"p":"","o":"在标点附近通过“跟随高天讯使”即可开始挑战","l":"zh-CN"},{"p":"","o":"该挑战位置位于上重力区域 请注意切换重力方向后追踪前往","l":"zh-CN"},{"p":"","o":"在标点附近开启挑战 首次完成挑战后可获得宝箱","l":"zh-CN"},{"p":"","o":"象征着慈爱的塑像，聆听着拉古那人民对修会的祷告与颂赞。\n具体位置在河道的中间有个拿剑的半身巨型骑士像处起飞，往右上方冲刺会看到一个图一的画面就是走对了。图二为俯视图方便找位置","l":"zh-CN"},{"k":"해당 적은 기류 피해 저항이 증가한다. \n자애를 상징하는 조각상, 라군나 사람들의 수도회를 향한 기도와 찬송을 경청한다.\n의심스러운 사람이나 에코를 발견하면 즉시 체포하고 계령원에 송치해 심판을 집행하여 성 내의 평안이 파괴되지 않도록 보장한다"},{"p":"","o":"在最底层巨像前面的河道拐过来（如图二所示）\n象征着慈爱的塑像，聆听着拉古那人民对修会的祷告与颂赞。一旦发现可疑人员或是声骸，会立刻对其进行抓捕并带入诫令院进行审判，以确保城内的安定不被打扰破坏。","l":"zh-CN"},{"p":"","o":"在最底层巨像前的河道向左拐进来，在河边的路上（如图二所示）  \n象征着慈爱的塑像，聆听着拉古那人民对修会的祷告与颂赞。一旦发现可疑人员或是声骸，会立刻对其进行抓捕并带入诫令院进行审判，以确保城内的安定不被打扰破坏。","l":"zh-CN"},{"p":"","o":"在最底层巨像前的河道向左拐进来，在河边的路上（如图二所示） 象征着慈爱的塑像，聆听着拉古那人民对修会的祷告与颂赞。一旦发现可疑人员或是声骸，会立刻对其进行抓捕并带入诫令院进行审判，以确保城内的安定不被打扰破坏。","l":"zh-CN"},{"p":"","o":"在最底层巨像前的河道向左拐进来，从图二传送点走到图三尽头，向下落能到隐藏水道 象征着慈爱的塑像，聆听着拉古那人民对修会的祷告与颂赞。一旦发现可疑人员或是声骸，会立刻对其进行抓捕并带入诫令院进行审判，以确保城内的安定不被打扰破坏。","l":"zh-CN"},{"k":"평소에는 검을 든 장엄한 조각상처럼, 조용히 수도회를 도와 라군나 성의 조화와 치안을 유지한다.\n의심스러운 사람이나 에코를 발견하면 즉시 체포하고 계령원에 송치해 심판을 집행하여 성 내의 평안이 파괴되지 않도록 보장한다"},{"p":"","o":"在最下层的房间里，触发里面的欺诈宝箱后会活过来","l":"zh-CN"}],"markers":[["1358868362183401472",0,2260.6,2512.0,"0",-1,0],["1527457975621111808",0,1947.1,2681.7,"0",0,0],["1527459215281864704",0,2620.2,1865.8,"0",0,0],["1527459638733950976",0,1813.4,1987.8,"0",0,0],["1527460100988846080",0,2395.3,2903.0,"0",-1,0],["1527460454736445440",0,2883.2,2583.2,"0",-1,0],["1527460773574852608",0,2304,1713.1,"0",-1,0],["1527465951493472256",0,1669.7,2416.0,"0",-1,0],["1531770380891537408",0,1679.4,2216.3,"0",-1,0],["1531770485791080448",0,2095.7,1836.0,"0",-1,0],["1358821665315053568",1,2298.4,1834.1,"0",-1,0],["1354838564342779904",2,2288.6,2546.1,"0",1,0],["1354839327601250304",2,2340.1,2548.0,"0",2,0],["1354840663894581248",2,2318.5,2549.8,"0",3,0],["1354843051929952256",2,2389.8,2713.3,"0",4,0],["1354846509944197120",2,2310.3,3215.7,"0",5,0],["1354847068382879744",2,2292.3,3228.3,"0",6,0],["1354847529320112128",2,2303.1,3261.7,"0",7,0],["1354849496062152704",2,3081.0,2668.1,"0",8,0],["1354850151590584320",2,3115.4,2660.9,"0",9,0],["1354850786771787776",2,3117.2,2666.3,"0",10,0],["1354851223888908288",2,3110.9,2652.8,"0",11,0],["1354852160762863616",2,2901.2,2830.8,"0",12,0],["1354856130365415424",2,2069.1,2368.2,"0",13,0],["1354856429134077952",2,2049.2,2373.6,"0",14,0],["1354858596326760448",2,1789.0,2779.3,"0",15,0],["1354859179783806976",2,1827.8,2822.6,"0",16,0],["1354864382222327808",2,1876.6,2534.4,"0",17,0],["1354865865655377920",2,1883.9,2536.2,"0",18,0],["1354867824730890240",2,1614.6,2732.3,"0",19,0],["1354874329353342976",2,1679.7,2205.5,"0",20,0],["1354877699091390464",2,1933.6,2118.8,"0",21,0],["1354878447606222848",2,1920.9,2272.